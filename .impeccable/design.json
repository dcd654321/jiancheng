      "css": ".ds-chip{display:inline-flex;align-items:center;padding:2px 7px;border-radius:5px;background:var(--color-busy-bg,#edf6ef);color:var(--color-busy-text,#246446);font:500 13px/1.5 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}"
