      "css": ".ds-field-label{display:block;margin-bottom:8px;color:var(--color-ink,#18382c);font:600 14px/1.5 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-field{height:48px;width:100%;padding:0 12px;border:1px solid var(--color-field-border,#c6d8cc);border-radius:9px;background:var(--color-surface,#fff);color:var(--color-ink,#18382c);font:400 15px/1.5 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;caret-color:var(--color-primary,#246446)}.ds-field:hover{border-color:var(--color-control-border,#7a897d)}.ds-field:focus-visible{outline:0;box-shadow:inset 0 0 0 2px var(--color-primary,#246446)}.ds-field[aria-invalid=true]{border-color:var(--color-error,#a23c2e);box-shadow:inset 0 0 0 1px var(--color-error,#a23c2e)}"
