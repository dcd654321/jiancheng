      "css": ".ds-primary{min-height:44px;padding:9px 14px;border:0;border-radius:10px;background:var(--color-primary,#246446);color:var(--color-on-primary,#fff);font:600 15px/1.5 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-primary:hover,.ds-primary:active{box-shadow:inset 0 0 0 999px rgba(0,0,0,.14)}.ds-primary:focus-visible{outline:2px solid var(--color-primary,#246446);outline-offset:3px}.ds-primary:disabled{background:var(--color-soft,#f7faf7);color:var(--color-secondary,#587065);box-shadow:none}"
