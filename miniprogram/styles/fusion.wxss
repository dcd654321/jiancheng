/* 固定融合稿的共用排版。颜色由 theme-tokens.js 生成。 */
.page { padding: 18px 20px calc(24px + env(safe-area-inset-bottom)); color: var(--color-ink); }
.heading, .heading-xl { font-size: 24px; line-height: 1.32; font-weight: 700; }
.page-header { align-items: flex-start; margin-bottom: 0; }
.card, .group { border-radius: 10px; }
.primary, .secondary { font-weight: 600; }
.add-button { color: var(--color-primary); background: var(--color-busy-bg); border-color: var(--color-accent-border); }
.back-heading { display: flex; align-items: center; gap: 8px; margin-left: -10px; min-height: 44px; }
.back-heading .heading { margin: 0; font-size: 22px; }
.back-button { width: 44px; min-width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
.back-chevron { transform: rotate(135deg); }
.switch-hit { min-width: 48px; min-height: 44px; display: flex; align-items: center; justify-content: flex-end; }
.input, .picker { border-color: var(--color-control-border); }
.photo-backdrop { position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,.3); display: flex; align-items: flex-end; }
.photo-panel { width: 100%; max-height: 82vh; overflow-y: auto; padding: 16px 16px calc(16px + env(safe-area-inset-bottom)); border-radius: 16px 16px 0 0; background: var(--color-surface); }
.photo-grid { display: flex; flex-wrap: wrap; gap: 12px; }
.photo-cell { width: calc(33.333% - 8px); min-width: 88px; }
.photo-image { width: 100%; height: 100px; border-radius: 10px; }
.photo-panel button { min-height: 44px; }
@media (max-width: 359px) { .page { padding-left: 16px; padding-right: 16px; } }
