<template name="photo-checkin">
  <view wx:if="{{photoOpen}}" class="photo-backdrop" catchtap="onPhotoClose"><view class="photo-panel" catchtap="onPhotoBackdrop"><view class="row"><view class="section-title grow">{{photoTitle}}</view><button class="text-button" disabled="{{photoBusy}}" bindtap="onPhotoClose">收起</button></view><view class="sub">按约定至少一张照片 · 最多3张，每张压缩后不超过2MiB</view><view class="photo-grid spaced"><view wx:for="{{photoItems}}" wx:key="localId" class="photo-cell"><image class="photo-image" src="{{item.path}}" mode="aspectFill" /><view class="sub">{{item.status === 'ready' ? '上传已确认' : item.status === 'failed' ? '上传失败' : '正在上传'}}</view><button class="text-button" disabled="{{photoBusy || photoPending}}" data-id="{{item.localId}}" bindtap="onPhotoRemove">移除</button></view></view><button class="secondary spaced" disabled="{{photoBusy || photoPending || photoItems.length >= 3}}" bindtap="onPhotoChoose">拍照或从相册选取</button><view wx:if="{{photoError}}" class="error spaced">{{photoError}}</view><button wx:if="{{photoItems.length && !photoCanSubmit && !photoPending}}" class="text-button" disabled="{{photoBusy}}" bindtap="onPhotoRetry">重试上传</button><button class="primary spaced" disabled="{{!photoCanSubmit}}" loading="{{photoBusy}}" bindtap="onPhotoSubmit">{{photoPending ? '核对这次打卡' : '提交并打卡'}}</button><view class="sub spaced">确认上传后即可打卡。照片检查期间，监督人会看到处理中。</view></view></view>

</template>
