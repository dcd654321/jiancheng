<template name="task">
  <view class="task {{task.done ? 'done' : ''}}">
    <view class="task-top">
      <button wx:if="{{!detail}}" class="task-open" data-id="{{task.id}}" bindtap="onOpen" aria-label="查看{{task.title}}">
        <view class="task-title">{{task.title}}<text wx:if="{{task.pinned}}" class="small"> · 置顶</text></view>
        <view class="task-goal">
          <text wx:if="{{task.time}}" class="goal-time">{{task.time}}</text>
          <text class="goal-main">{{task.simplified ? '今天' + task.target + task.unit : '平时' + task.originalTarget + task.unit}}</text>
          <text wx:if="{{task.simplified}}" class="sub">原计划 {{task.originalTarget}}{{task.unit}} · 今天已调小</text>
          <text wx:elif="{{task.minimum}}" class="chip-lime">忙时 {{task.minimum}}{{task.unit}}</text>
        </view>
      </button>
      <view wx:else class="task-open">
        <view class="task-title">{{task.title}}<text wx:if="{{task.pinned}}" class="small"> · 置顶</text></view>
        <view class="task-goal">
          <text wx:if="{{task.time}}" class="goal-time">{{task.time}}</text>
          <text class="goal-main">{{task.simplified ? '今天' + task.target + task.unit : '平时' + task.originalTarget + task.unit}}</text>
          <text wx:if="{{task.simplified}}" class="sub">原计划 {{task.originalTarget}}{{task.unit}} · 今天已调小</text>
          <text wx:elif="{{task.minimum}}" class="chip-lime">忙时 {{task.minimum}}{{task.unit}}</text>
        </view>
      </view>
      <view wx:if="{{task.done}}" class="done-tag"><icon type="success" size="20" color="{{taskIconColor}}" /><text>{{task.status === 'minimum' ? '忙时完成' : '原目标完成'}}</text></view>
    </view>
    <view wx:if="{{!task.done}}" class="task-actions">
      <block wx:if="{{task.simplified}}">
        <button class="check-pill" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" data-done="{{false}}" bindtap="onComplete" aria-label="已完成{{task.title}}，按今天的目标{{task.target}}{{task.unit}}记下">{{recordingId === task.id && recordingType === 'complete' ? recordingLabel : '按今天 ' + task.target + task.unit + ' 记下'}}</button>
        <button class="text-button" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" bindtap="onRestore">{{recordingId === task.id && recordingType === 'restore' ? recordingLabel : '恢复今天原目标'}}</button>
      </block>
      <block wx:elif="{{quickMinimumEnabled && task.minimum}}">
        <button class="check-pill" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" data-done="{{false}}" bindtap="onComplete" aria-label="已完成{{task.title}}，按原目标{{task.originalTarget}}{{task.unit}}记下今天">{{recordingId === task.id && recordingType === 'complete' ? recordingLabel : '按 ' + task.target + task.unit + ' 记下'}}</button>
        <button class="soft-button" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" bindtap="onCompleteMinimum" aria-label="已完成{{task.title}}忙时目标，按{{task.minimum}}{{task.unit}}记下今天">{{recordingId === task.id && recordingType === 'completeMinimum' ? recordingLabel : '按忙时 ' + task.minimum + task.unit + ' 记下'}}</button>
      </block>
      <block wx:else>
        <button class="check-pill" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" data-done="{{false}}" bindtap="onComplete" aria-label="已完成{{task.title}}，按今天的目标{{task.target}}{{task.unit}}记下">{{recordingId === task.id && recordingType === 'complete' ? recordingLabel : '按 ' + task.target + task.unit + ' 记下'}}</button>
      </block>
      <button wx:if="{{detail && !task.simplified && task.originalTarget > 1}}" class="text-button" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" bindtap="onSimplify">只调整今天目标（不记录）</button>
    </view>
    <view wx:if="{{task.done}}" class="task-options">
      <button class="text-button undo" disabled="{{readOnly || writeBusy}}" data-id="{{task.id}}" data-date="{{task.date}}" data-done="{{true}}" bindtap="onComplete" aria-label="撤销{{task.title}}今天的打卡">{{recordingId === task.id && recordingType === 'undo' ? recordingLabel : '撤销打卡'}}</button>
    </view>
  </view>
</template>
