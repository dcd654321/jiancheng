<template name="task">
  <view class="task {{task.done ? 'completed' : ''}}">
    <view class="row">
      <button wx:if="{{!detail}}" class="task-open" data-id="{{task.id}}" bindtap="onOpen" aria-label="查看{{task.title}}">
        <view class="task-title">{{task.title}}</view>
        <view class="sub">{{task.time ? task.time + ' · ' : ''}}{{task.target}} {{task.unit}}</view>
        <view wx:if="{{task.simplified}}" class="small minimum-tag">今天做 {{task.target}}{{task.unit}} · 原目标 {{task.originalTarget}}{{task.unit}}</view>
      </button>
      <view wx:else class="task-open">
        <view class="task-title">{{task.target}} {{task.unit}}</view>
        <view class="sub">{{task.time ? task.time + ' · ' : ''}}{{task.statusText}}</view>
        <view wx:if="{{task.simplified}}" class="small minimum-tag">仅今天调整 · 原目标 {{task.originalTarget}}{{task.unit}}</view>
      </view>
      <view wx:if="{{task.done}}" class="completed-status"><icon type="success" size="22" color="#245c44" /><text>已完成</text></view>
      <button wx:else class="check-button" data-id="{{task.id}}" data-date="{{task.date}}" data-done="{{false}}" bindtap="onComplete" aria-label="完成{{task.title}}">
        <icon type="circle" size="27" color="#7d8b80" /><text class="check-label">打卡</text>
      </button>
    </view>
    <view class="task-options">
      <block wx:if="{{!task.done && task.originalTarget > 1}}">
        <button class="text-button" data-id="{{task.id}}" data-date="{{task.date}}" bindtap="onSimplify">今天少做一点{{task.minimum ? ' · ' + task.minimum + task.unit : ''}}</button>
        <button wx:if="{{task.simplified}}" class="text-button" data-id="{{task.id}}" data-date="{{task.date}}" bindtap="onRestore">恢复原目标</button>
      </block>
      <button wx:if="{{task.done}}" class="text-button undo" data-id="{{task.id}}" data-date="{{task.date}}" data-done="{{true}}" bindtap="onComplete" aria-label="撤销{{task.title}}今天的打卡">撤销打卡</button>
    </view>
  </view>
</template>
