page { background: #ffffff; color: #183b31; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 16px; line-height: 1.6; }
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: #183b31; font: inherit; line-height: 1.5; }
button::after { border: none; }
button[disabled] { color: #65756c; background: #f1f4ef; }
.page { padding: 20px 20px calc(28px + env(safe-area-inset-bottom)); max-width: 560px; margin: 0 auto; }
.heading { font-size: 22px; line-height: 1.4; font-weight: 700; margin-bottom: 6px; overflow-wrap: anywhere; }
.section-title { font-size: 18px; font-weight: 600; margin: 24px 0 10px; }
.sub { font-size: 14px; color: #65756c; line-height: 1.65; }
.small { font-size: 14px; }
.row { display: flex; align-items: center; gap: 12px; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.line { height: 1px; background: #e8ede7; margin: 20px 0; }
.primary, .secondary { width: 100%; min-height: 48px; padding: 12px 16px; border-radius: 12px; font-size: 16px; font-weight: 600; text-align: center; }
.primary { background: #245c44; color: #fff; }
.secondary { color: #245c44; border: 1px solid #245c44; background: white; }
.text-button { min-height: 44px; padding: 10px 8px; color: #245c44; font-size: 14px; }
.actions { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
.notice { background: #f1f5ee; border-radius: 10px; padding: 12px 14px; font-size: 14px; color: #53675b; margin-top: 20px; }
.first-guide { display: flex; align-items: flex-start; gap: 8px; overflow-wrap: anywhere; }
.first-guide .text-button { flex-shrink: 0; }
.error { background: #fff0e9; color: #983e28; border-radius: 10px; padding: 12px; margin: 0 0 16px; font-size: 14px; overflow-wrap: anywhere; }
.empty { padding: 30px 0; }
.empty .heading { font-size: 23px; }
.empty .sub { margin: 12px 0 24px; }
.task { border-bottom: 1px solid #e8ede7; padding: 10px 0; }
.task-open { flex: 1; text-align: left; min-height: 52px; min-width: 0; padding: 5px 0; }
.task-title { font-size: 17px; font-weight: 600; overflow-wrap: anywhere; }
.task-goals { overflow-wrap: anywhere; }
.task-current { color: #245c44; font-weight: 600; overflow-wrap: anywhere; }
.check-button { width: 60px; min-height: 60px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; }
.check-label { font-size: 14px; color: #53675b; line-height: 1.4; }
.task-options { display: flex; gap: 8px; flex-wrap: wrap; }
.task-options .text-button { padding-left: 0; text-align: left; }
.completed .task-title { color: #53675b; }
.minimum-tag { color: #496934; }
.form-field { margin-top: 20px; }
.field-label { display: block; margin-bottom: 8px; font-size: 16px; font-weight: 600; }
.input { width: 100%; min-height: 48px; height: 48px; padding: 10px 12px; border: 1px solid #dce4dc; border-radius: 10px; background: white; font-size: 16px; }
/* Native input paints its own vertically centered text; vertical padding offsets its unfocused layer. */
input.input { padding-top: 0; padding-bottom: 0; }
textarea.input { height: 104px; line-height: 1.6; }
.picker { min-height: 48px; padding: 10px 12px; border: 1px solid #dce4dc; border-radius: 10px; }
.day-options { display: flex; flex-wrap: wrap; gap: 8px; }
.day-option { min-width: 44px; min-height: 44px; padding: 10px; border: 1px solid #dce4dc; border-radius: 9px; font-size: 14px; }
.day-option.selected { background: #245c44; color: white; border-color: #245c44; }
.segments { display: flex; gap: 4px; padding: 4px; border: 1px solid #dce4dc; border-radius: 12px; margin: 20px 0; }
.segment { flex: 1; min-height: 44px; padding: 10px 6px; font-size: 15px; border-radius: 8px; }
.segment.selected { background: #245c44; color: white; }
.metric { font-size: 44px; font-weight: 700; line-height: 1.2; }
.metric-suffix { font-size: 18px; }
.meter { height: 8px; background: #edf1e9; border-radius: 8px; margin-top: 10px; overflow: hidden; }
.meter-fill { background: #245c44; height: 100%; border-radius: 8px; }
.calendar { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5px; margin: 20px 0; }
.cell { min-height: 50px; border-radius: 8px; padding: 5px 1px; background: #f1f4ef; font-size: 14px; border: 1px solid transparent; }
.cell-weekday { display: block; font-size: 13px; }
.cell.full { background: #245c44; color: white; }
.cell.partial { background: #ddf3a4; }
.cell.rest { background: white; color: #65756c; border-color: #e8ede7; }
.cell.picked { box-shadow: inset 0 0 0 2px #183b31; }
.setting-row { width: 100%; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding: 14px 0; border-bottom: 1px solid #e8ede7; }
.danger { color: #983e28; }
.spaced { margin-top: 20px; }
.template-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.template-choice { border: 1px solid #dce4dc; border-radius: 10px; font-size: 14px; padding: 10px 12px; min-height: 44px; }
.inline-note { border-left: 3px solid #ddf3a4; padding-left: 12px; margin: 14px 0; }
.compact-form .form-field { margin-top: 16px; }
.week-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.week-options .day-option { min-width: 0; width: 100%; min-height: 48px; padding: 10px 0; font-size: 16px; }
.direction-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.direction-options .day-option { min-width: 0; min-height: 48px; }
.field-error { color: #983e28; font-size: 14px; margin-top: 6px; }
.goal-row .input { width: 0; }
.picker-select { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.chevron { width: 16px; height: 16px; background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%3E%3Cpath%20d%3D%22m6%203%205%205-5%205%22%20fill%3D%22none%22%20stroke%3D%22%23245c44%22%20stroke-width%3D%221.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E") center / 16px 16px no-repeat; flex-shrink: 0; }
.chevron.down { transform: rotate(90deg); }
.chevron.up { transform: rotate(-90deg); }
.disclosure { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 48px; padding: 10px 0; text-align: left; border-bottom: 1px solid #e8ede7; }
.optional-fields { padding: 0 0 8px; }
.frequency-actions { gap: 16px; }
.frequency-actions .text-button { padding-left: 0; }
.page-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.add-button { border: 1px solid #245c44; border-radius: 10px; padding: 10px 12px; min-height: 44px; font-size: 14px; color: #245c44; flex-shrink: 0; }
.quote { margin: 8px 0 16px; }
.group { margin-top: 24px; }
.group-label { font-size: 14px; color: #65756c; margin-bottom: 4px; }
.menu-value { text-align: right; max-width: 55%; overflow-wrap: anywhere; }
.setting-row > .sub { flex-shrink: 0; }
.completed-status { display: flex; align-items: center; gap: 5px; max-width: 112px; font-size: 14px; line-height: 1.4; color: #245c44; flex-shrink: 0; }
.task-options .undo { margin-left: auto; }
.note-preview { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; color: #53675b; margin: 12px 0; }
.metric-caption { font-size: 16px; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 14px; color: #53675b; }
.legend-item { display: flex; align-items: center; gap: 5px; }
.legend-mark { width: 12px; height: 12px; border-radius: 3px; border: 1px solid #dce4dc; }
.legend-mark.full { background: #245c44; }
.legend-mark.partial { background: #ddf3a4; }
.legend-mark.pending { background: #f1f4ef; }
.cell-status { display: block; font-size: 12px; line-height: 1.4; }
.danger-zone { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e8ede7; }
