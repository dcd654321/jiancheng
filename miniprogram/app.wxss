@import "styles/theme.wxss";

/* 渐成习惯打卡 · 共享视觉层
   两套主题（薄雾绿 mist 缺省 / 暖纸白 paper）只换语义颜色：token 唯一来源是
   miniprogram/config/theme-tokens.js，由 scripts/build-themes.cjs 生成 theme.wxss。
   页面根节点带 theme-mist / theme-paper 作用域；page 元素与未加载主题时回退 mist 值。
   字号/触区用 px，弹性布局用 flex/%；正文16px、辅助14px、关键触区≥44px、按钮推荐48px。 */
page {
  background: #F7F8F5;
  color: #303A34;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 16px; line-height: 1.5;
}
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: #303A34; font: inherit; line-height: 1.5; }
button::after { border: none; }
button[disabled] { color: #647067; background: #F1F4EF; border-color: #E2E7DF; opacity: 1; }
/* 按下反馈：日常控件用浅面，实心提交按钮用内侧加深，都保持文字对比。 */
button.button-hover { background: #F1F4EF; }
button.primary.button-hover { background: #486557; box-shadow: inset 0 0 0 999px rgba(0, 0, 0, .14); }

.page {
  padding: 20px 18px calc(28px + env(safe-area-inset-bottom));
  max-width: 560px; margin: 0 auto;
  min-height: 100vh;
  background: var(--color-page, #F7F8F5);
}
@media (max-width: 359px) {
  .page { padding-left: 16px; padding-right: 16px; }
}
.heading { font-size: 26px; line-height: 1.3; font-weight: 600; margin-bottom: 6px; overflow-wrap: anywhere; }
.heading-xl { font-size: 26px; }
.section-title { font-size: 20px; line-height: 1.3; font-weight: 600; margin: 24px 0 12px; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; overflow-wrap: anywhere; }
.section-count { font-size: 14px; font-weight: 400; color: var(--color-secondary, #647067); }
.sub { font-size: 14px; color: var(--color-secondary, #647067); line-height: 1.5; }
.small { font-size: 14px; }
.row { display: flex; align-items: center; gap: 12px; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.line { height: 1px; background: var(--color-line, #E2E7DF); margin: 20px 0; }

/* 卡片与分组：纯色浅面 + 细装饰线，不用投影。 */
.card { background: var(--color-surface, #fff); border: 1px solid var(--color-line, #E2E7DF); border-radius: 16px; }
.group { background: var(--color-surface, #fff); border: 1px solid var(--color-line, #E2E7DF); border-radius: 16px; padding: 2px 16px; margin-top: 20px; }
.group-label { font-size: 14px; color: var(--color-secondary, #647067); margin: 14px 0 0; }
.list-card { padding: 2px 16px; margin-top: 10px; }

/* 按钮：推荐48px，触区不小于44×44px；多行时min-height并允许增高。 */
.primary, .secondary { width: 100%; min-height: 48px; padding: 12px 16px; border-radius: 12px; font-size: 16px; font-weight: 600; text-align: center; overflow-wrap: anywhere; }
.primary { background: var(--color-primary, #486557); color: var(--color-on-primary, #fff); }
.secondary { color: var(--color-ink, #303A34); border: 1px solid var(--color-control-border, #819086); background: var(--color-surface, #fff); }
.text-button { min-height: 44px; padding: 10px 8px; color: var(--color-primary, #486557); font-size: 14px; }
.link-button { min-height: 44px; padding: 10px 8px; color: var(--color-primary, #486557); font-size: 14px; }
.actions { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
/* 日常记录主动作：surface + 1px 描边，不用整条亮色填充。 */
.check-pill { width: 100%; padding: 12px 16px; min-height: 48px; border-radius: 12px; border: 1px solid var(--color-control-border, #819086); color: var(--color-ink, #303A34); background: var(--color-surface, #fff); font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
.check-pill.button-hover { background: var(--color-soft, #F1F4EF); }
/* 忙时动作：中性浅面 + 边框，不使用忙时色整条填色。 */
.soft-button { width: 100%; border: 1px solid var(--color-control-border, #819086); background: var(--color-soft, #F1F4EF); color: var(--color-ink, #303A34); font-size: 16px; font-weight: 600; border-radius: 12px; padding: 12px 16px; min-height: 48px; overflow-wrap: anywhere; }
.chip-lime { display: inline-flex; align-items: center; background: var(--color-busy-bg, #EDF1E2); color: var(--color-busy-text, #536343); font-size: 14px; font-weight: 600; border-radius: 6px; padding: 2px 8px; line-height: 1.5; }
.add-button { border: 1px solid var(--color-control-border, #819086); border-radius: 12px; padding: 10px 14px; min-height: 44px; font-size: 14px; color: var(--color-ink, #303A34); flex-shrink: 0; background: var(--color-surface, #fff); }

/* 提示与错误 */
.notice { background: var(--color-soft, #F1F4EF); border-radius: 12px; padding: 12px 14px; font-size: 14px; color: var(--color-secondary, #647067); margin-top: 20px; }
.first-guide { display: flex; align-items: flex-start; gap: 8px; overflow-wrap: anywhere; }
.first-guide .text-button { flex-shrink: 0; }
.error { background: var(--color-error-bg, #FFF1EB); color: var(--color-error, #A33D2A); border-radius: 12px; padding: 12px; margin: 0 0 16px; font-size: 14px; overflow-wrap: anywhere; }
.empty { padding: 30px 0; }
.empty .sub { margin: 12px 0 24px; }
.inline-note { border-left: 3px solid var(--color-line, #E2E7DF); padding-left: 12px; margin: 14px 0; }

/* 首次进入 */
.hero-title { font-size: 26px; line-height: 1.3; font-weight: 600; margin: 18px 0 8px; }
.hero-sub { font-size: 14px; color: var(--color-secondary, #647067); line-height: 1.5; }
.tpl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 24px 0 14px; }
.tpl-card { text-align: left; background: var(--color-surface, #fff); border: 1px solid var(--color-control-border, #819086); border-radius: 16px; padding: 13px 14px; min-height: 44px; }
.tpl-name { display: block; font-size: 16px; font-weight: 600; margin-bottom: 5px; overflow-wrap: anywhere; }
.tpl-line { display: block; font-size: 14px; color: var(--color-secondary, #647067); line-height: 1.5; overflow-wrap: anywhere; }
.tpl-chip { display: inline-block; margin-top: 6px; background: var(--color-busy-bg, #EDF1E2); color: var(--color-busy-text, #536343); border-radius: 6px; padding: 2px 8px; font-size: 14px; font-weight: 600; }
.template-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.template-choice { border: 1px solid var(--color-control-border, #819086); border-radius: 12px; font-size: 14px; padding: 10px 12px; min-height: 44px; background: var(--color-surface, #fff); }

/* 今日进度与任务卡 */
.progress-card { padding: 15px 16px 16px; margin-top: 4px; }
.progress-row { display: flex; align-items: baseline; justify-content: space-between; }
.progress-title { font-size: 16px; font-weight: 600; }
.progress-value { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
.progress-note { font-size: 14px; color: var(--color-secondary, #647067); margin-top: 8px; }
.meter { height: 8px; background: var(--color-soft, #F1F4EF); border-radius: 6px; margin-top: 10px; overflow: hidden; }
.meter-fill { background: var(--color-primary, #486557); height: 100%; border-radius: 6px; }
.task { background: var(--color-surface, #fff); border: 1px solid var(--color-line, #E2E7DF); border-radius: 16px; padding: 15px 16px 13px; margin-bottom: 12px; }
.task-top { display: flex; align-items: flex-start; gap: 12px; }
.task-open { flex: 1; min-width: 0; text-align: left; min-height: 44px; overflow-wrap: anywhere; }
.task-title { font-size: 18px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }
.task-goal { margin-top: 6px; font-size: 14px; color: var(--color-secondary, #647067); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.task-goal .goal-main { color: var(--color-ink, #303A34); font-weight: 600; }
.task-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
.task-options { display: flex; align-items: center; gap: 14px; margin-top: 10px; flex-wrap: wrap; }
.task-options .text-button { padding: 6px 0; }
.task-options .undo { margin-left: auto; }
.done-tag { display: inline-flex; align-items: center; gap: 5px; color: var(--color-ink, #303A34); font-size: 14px; font-weight: 600; flex-shrink: 0; max-width: 140px; }
.stamp-in { animation: stamp-in .26s ease-out both; }
@keyframes stamp-in { 0% { transform: scale(1.35); opacity: 0; } 60% { transform: scale(.96); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }

/* 回归提示：只留一句引导，操作回到任务行本身。 */
.return-card { padding: 15px 16px; margin-bottom: 12px; }
.return-heading { color: var(--color-ink, #303A34); font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
.return-body { margin-top: 6px; }

/* 折叠入口 */
.disclosure { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 52px; padding: 13px 16px; text-align: left; background: var(--color-surface, #fff); border: 1px solid var(--color-line, #E2E7DF); border-radius: 16px; margin-top: 10px; }
.chevron { width: 8px; height: 8px; border-right: 1.5px solid var(--color-primary, #486557); border-bottom: 1.5px solid var(--color-primary, #486557); transform: rotate(-45deg); flex-shrink: 0; margin: 0 4px; }
.chevron.down { transform: rotate(45deg); }
.chevron.up { transform: rotate(-135deg); }
.quote { margin: 22px 0 0; }

/* 表单 */
.form-field { margin-top: 20px; }
.field-label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: var(--color-ink, #303A34); }
.input { width: 100%; min-height: 48px; height: 48px; padding: 10px 14px; border: 1px solid var(--color-control-border, #819086); border-radius: 12px; background: var(--color-surface, #fff); font-size: 16px; color: var(--color-ink, #303A34); }
/* Native input paints its own vertically centered text; vertical padding offsets its unfocused layer. */
input.input { padding-top: 0; padding-bottom: 0; }
/* 焦点：2px primary 内侧轮廓，不改变布局；错误态另有 2px error 边框与文字说明。 */
.input.focused, .picker.focused { box-shadow: inset 0 0 0 2px var(--color-primary, #486557); }
textarea.input { height: 104px; line-height: 1.6; }
.picker { min-height: 48px; padding: 10px 14px; border: 1px solid var(--color-control-border, #819086); border-radius: 12px; background: var(--color-surface, #fff); }
.picker-select { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.goal-row .input { width: 0; }
.field-hint { font-size: 14px; color: var(--color-secondary, #647067); margin-top: 7px; line-height: 1.5; }
.field-error { color: var(--color-error, #A33D2A); font-size: 14px; margin-top: 6px; overflow-wrap: anywhere; }
.summary-line { font-size: 14px; color: var(--color-secondary, #647067); margin: 20px 0 14px; }
.summary-line .strong { color: var(--color-ink, #303A34); font-weight: 600; }
.day-options { display: flex; flex-wrap: wrap; gap: 8px; }
.day-option { min-width: 44px; min-height: 44px; padding: 10px; border: 1px solid var(--color-control-border, #819086); border-radius: 12px; font-size: 14px; background: var(--color-surface, #fff); color: var(--color-ink, #303A34); }
.day-option.selected { background: var(--color-primary, #486557); color: var(--color-on-primary, #fff); border-color: var(--color-primary, #486557); }
.week-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.week-options .day-option { min-width: 0; width: 100%; min-height: 48px; padding: 10px 0; font-size: 16px; }
.direction-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.direction-options .day-option { min-width: 0; min-height: 48px; }
.frequency-actions { gap: 16px; }
.frequency-actions .text-button { padding-left: 0; }
.optional-fields { padding: 0 0 8px; }
.compact-form .form-field { margin-top: 16px; }
.segments { display: flex; gap: 4px; padding: 4px; background: var(--color-soft, #F1F4EF); border-radius: 12px; margin: 12px 0 4px; }
.segment { flex: 1; min-height: 44px; padding: 8px 6px; font-size: 16px; border-radius: 12px; color: var(--color-secondary, #647067); }
.segment.selected { background: var(--color-surface, #fff); color: var(--color-ink, #303A34); font-weight: 600; border: 1px solid var(--color-line, #E2E7DF); }

/* 统计 */
.metric-card { padding: 18px 16px 16px; }
.metric-note { font-size: 14px; color: var(--color-secondary, #647067); margin-top: 8px; }
.metric { font-size: 40px; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
.metric-suffix { font-size: 16px; }
.metric-caption { font-size: 16px; }
.calendar { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5px; margin: 16px 0 12px; }
.cell { min-height: 50px; border-radius: 12px; padding: 5px 1px; background: var(--color-soft, #F1F4EF); font-size: 14px; border: 1px solid transparent; color: var(--color-ink, #303A34); }
.cell-weekday { display: block; font-size: 14px; }
.cell-status { display: block; font-size: 14px; line-height: 1.4; }
.cell.full { background: var(--color-primary, #486557); color: var(--color-on-primary, #fff); }
.cell.partial { background: var(--color-busy-bg, #EDF1E2); color: var(--color-busy-text, #536343); }
.cell.rest { background: transparent; color: var(--color-secondary, #647067); border-color: var(--color-line, #E2E7DF); }
.cell.picked { box-shadow: inset 0 0 0 2px var(--color-ink, #303A34); }
.legend { display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 14px; color: var(--color-secondary, #647067); }
.legend-item { display: flex; align-items: center; gap: 5px; }
.legend-mark { width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--color-control-border, #819086); }
.legend-mark.full { background: var(--color-primary, #486557); border-color: var(--color-primary, #486557); }
.legend-mark.partial { background: var(--color-busy-bg, #EDF1E2); border-color: var(--color-busy-bg, #EDF1E2); }
.legend-mark.pending { background: var(--color-soft, #F1F4EF); border-color: var(--color-soft, #F1F4EF); }
.legend-mark.rest { background: transparent; border: 1px dashed var(--color-control-border, #819086); }
.advice { display: flex; gap: 10px; align-items: flex-start; padding: 13px 14px; margin-top: 12px; }
.advice .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-primary, #486557); margin-top: 6px; flex-shrink: 0; }
.advice .advice-text { font-size: 14px; color: var(--color-ink, #303A34); line-height: 1.5; }
.advice .advice-label { font-size: 14px; color: var(--color-secondary, #647067); display: block; margin-top: 2px; }
.range { font-size: 14px; color: var(--color-secondary, #647067); margin: 12px 0 14px; }

/* 设置行 */
.setting-row { width: 100%; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; padding: 14px 0; border-bottom: 1px solid var(--color-line, #E2E7DF); color: var(--color-ink, #303A34); }
.group .setting-row:last-child, .list-card .setting-row:last-child { border-bottom: 0; }
.setting-row > .sub { flex-shrink: 0; }
.menu-value { text-align: right; max-width: 55%; overflow-wrap: anywhere; }
.danger { color: var(--color-error, #A33D2A); }
.danger-zone { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--color-line, #E2E7DF); }
.note-preview { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; color: var(--color-secondary, #647067); margin: 12px 0; }
.spaced { margin-top: 20px; }

/* 骨架 */
.skeleton { background: var(--color-soft, #F1F4EF); border-radius: 12px; animation: skeleton-pulse 1.6s ease-in-out infinite; }
.skeleton-title { width: 42%; height: 26px; margin-top: 14px; border-radius: 12px; }
.skeleton-sub { width: 58%; height: 14px; margin-top: 10px; }
.skeleton-card { height: 84px; margin-top: 12px; border-radius: 16px; }
.skeleton-note { margin-top: 16px; }
@keyframes skeleton-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

/* 分享预览（功能未启用，样式保留） */
.share-sheet { margin-top: 24px; padding: 24px 20px; border: 1px solid var(--color-line, #E2E7DF); border-radius: 16px; background: var(--color-soft, #F1F4EF); overflow-wrap: anywhere; }
.share-line { margin-top: 18px; line-height: 1.5; }

.page-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
