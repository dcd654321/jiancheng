@import "styles/theme.wxss";

/* 渐成习惯打卡 · 共享视觉层
   两套主题（薄雾绿 mist 缺省 / 暖纸白 paper）只换语义颜色：token 唯一来源是
   miniprogram/config/theme-tokens.js，由 scripts/build-themes.cjs 生成 theme.wxss。
   页面根节点带 theme-mist / theme-paper 作用域；page 元素与未加载主题时回退 mist 值。
   字号/触区用 px，弹性布局用 flex/%；正文15px、辅助13px、页标题24px，关键触区≥44px。 */
page {
  background: #FFFFFF;
  color: #18382C;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 15px; line-height: 1.5;
}
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--color-ink, #18382C); font: inherit; line-height: 1.5; }
button::after { border: none; }
button[disabled] { color: var(--color-secondary, #587065); background: var(--color-soft, #F7FAF7); border-color: var(--color-line, #DCE7DF); opacity: 1; }
/* 按下反馈：日常控件用浅面，实心提交按钮用内侧加深，都保持文字对比。 */
button.button-hover { background: var(--color-soft, #F7FAF7); }
button.primary.button-hover { background: var(--color-primary, #246446); box-shadow: inset 0 0 0 999px rgba(0, 0, 0, .14); }

.page {
  padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
  max-width: 560px; margin: 0 auto;
  min-height: 100vh;
  background: var(--color-page, #FFFFFF);
}
@media (max-width: 359px) {
  .page { padding-left: 16px; padding-right: 16px; }
}
.heading { font-size: 24px; line-height: 1.3; font-weight: 600; margin-bottom: 4px; overflow-wrap: anywhere; }
.heading-xl { font-size: 24px; }
.section-title { font-size: 16px; line-height: 1.45; font-weight: 600; margin: 20px 0 10px; display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; overflow-wrap: anywhere; }
.section-count { font-size: 13px; font-weight: 400; color: var(--color-secondary, #587065); }
.sub { font-size: 13px; color: var(--color-secondary, #587065); line-height: 1.5; }
.small { font-size: 13px; }
.row { display: flex; align-items: center; gap: 12px; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.line { height: 1px; background: var(--color-line, #DCE7DF); margin: 16px 0; }

/* 卡片与分组：纯色浅面 + 细装饰线，不用投影。 */
.card { background: var(--color-surface, #fff); border: 1px solid var(--color-line, #DCE7DF); border-radius: 14px; }
.group { background: var(--color-surface, #fff); border: 1px solid var(--color-line, #DCE7DF); border-radius: 14px; padding: 2px 14px; margin-top: 16px; }
.group-label { font-size: 13px; color: var(--color-secondary, #587065); margin: 12px 0 0; }
.list-card { padding: 2px 14px; margin-top: 8px; }

/* 按钮：默认44px，触区不小于44×44px；多行时min-height并允许增高。 */
.primary, .secondary { width: 100%; min-height: 44px; padding: 9px 14px; border-radius: 10px; font-size: 15px; font-weight: 600; text-align: center; overflow-wrap: anywhere; }
.primary { background: var(--color-primary, #246446); color: var(--color-on-primary, #fff); }
.secondary { color: var(--color-ink, #18382C); border: 1px solid var(--color-control-border, #7A897D); background: var(--color-surface, #fff); }
.text-button { min-width: 44px; min-height: 44px; padding: 8px; color: var(--color-primary, #246446); font-size: 13px; }
.link-button { min-width: 44px; min-height: 44px; padding: 8px; color: var(--color-primary, #246446); font-size: 13px; }
.actions { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
/* 日常记录主动作：surface + 1px 描边，不用整条亮色填充。 */
.check-pill { width: 100%; padding: 9px 14px; min-height: 44px; border-radius: 10px; border: 1px solid var(--color-control-border, #7A897D); color: var(--color-ink, #18382C); background: var(--color-surface, #fff); font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.check-pill.button-hover { background: var(--color-soft, #F7FAF7); }
/* 忙时动作：中性浅面 + 边框，不使用忙时色整条填色。 */
.soft-button { width: 100%; border: 1px solid var(--color-control-border, #7A897D); background: var(--color-soft, #F7FAF7); color: var(--color-ink, #18382C); font-size: 15px; font-weight: 600; border-radius: 10px; padding: 9px 14px; min-height: 44px; overflow-wrap: anywhere; }
/* 打卡等待仅锁定重复提交，任务按钮保留原色；只读状态继续使用禁用样式。 */
.task-writing .check-pill[disabled], .task-writing .soft-button[disabled] { color: var(--color-ink, #18382C); border-color: var(--color-control-border, #7A897D); }
.task-writing .check-pill[disabled] { background: var(--color-surface, #fff); }
.task-writing .soft-button[disabled] { background: var(--color-soft, #F7FAF7); }
.task-writing .text-button[disabled] { color: var(--color-primary, #246446); background: transparent; }
.chip-lime { display: inline-flex; align-items: center; background: var(--color-busy-bg, #EDF6EF); color: var(--color-busy-text, #246446); font-size: 13px; font-weight: 500; border-radius: 5px; padding: 2px 7px; line-height: 1.5; }
.add-button { border: 1px solid var(--color-control-border, #7A897D); border-radius: 10px; padding: 8px 12px; min-height: 44px; font-size: 13px; color: var(--color-ink, #18382C); flex-shrink: 0; background: var(--color-surface, #fff); }

/* 提示与错误 */
.notice { background: var(--color-soft, #F7FAF7); border-radius: 10px; padding: 10px 12px; font-size: 13px; color: var(--color-secondary, #587065); margin-top: 16px; }
.first-guide { display: flex; align-items: flex-start; gap: 8px; overflow-wrap: anywhere; }
.first-guide .text-button { flex-shrink: 0; }
.error { background: var(--color-error-bg, #FFF1EC); color: var(--color-error, #A23C2E); border-radius: 10px; padding: 10px 12px; margin: 0 0 12px; font-size: 13px; overflow-wrap: anywhere; }
.empty { padding: 24px 0; }
.empty .sub { margin: 10px 0 20px; }
.inline-note { border-left: 3px solid var(--color-line, #DCE7DF); padding-left: 12px; margin: 14px 0; }

/* 首次进入 */
.hero-title { font-size: 22px; line-height: 1.3; font-weight: 600; margin: 16px 0 6px; }
.hero-sub { font-size: 13px; color: var(--color-secondary, #587065); line-height: 1.5; }
.tpl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 20px 0 12px; }
.tpl-card { text-align: left; background: var(--color-surface, #fff); border: 1px solid var(--color-control-border, #7A897D); border-radius: 14px; padding: 11px 12px; min-height: 44px; }
.tpl-name { display: block; font-size: 15px; font-weight: 600; margin-bottom: 4px; overflow-wrap: anywhere; }
.tpl-line { display: block; font-size: 13px; color: var(--color-secondary, #587065); line-height: 1.5; overflow-wrap: anywhere; }
.tpl-chip { display: inline-block; margin-top: 6px; background: var(--color-busy-bg, #EDF6EF); color: var(--color-busy-text, #246446); border-radius: 5px; padding: 2px 7px; font-size: 13px; font-weight: 500; }
.template-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.template-choice { border: 1px solid var(--color-control-border, #7A897D); border-radius: 10px; font-size: 13px; padding: 8px 10px; min-height: 44px; background: var(--color-surface, #fff); }

/* 今日进度与任务卡 */
.progress-card { padding: 13px 14px 14px; margin-top: 4px; }
.progress-row { display: flex; align-items: baseline; justify-content: space-between; }
.progress-title { font-size: 15px; font-weight: 600; }
.progress-value { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
.progress-note { font-size: 13px; color: var(--color-secondary, #587065); margin-top: 6px; }
.meter { height: 6px; background: var(--color-soft, #F7FAF7); border-radius: 5px; margin-top: 8px; overflow: hidden; }
.meter-fill { background: var(--color-primary, #246446); height: 100%; border-radius: 6px; }
.task { background: var(--color-surface, #fff); border: 1px solid var(--color-line, #DCE7DF); border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; }
.task-top { display: flex; align-items: flex-start; gap: 10px; }
.task-open { flex: 1; min-width: 0; text-align: left; min-height: 44px; overflow-wrap: anywhere; }
.task-title { font-size: 16px; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
.task-goal { margin-top: 4px; font-size: 13px; color: var(--color-secondary, #587065); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.task-goal .goal-main { color: var(--color-ink, #18382C); font-weight: 500; }
.task-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: stretch; margin-top: 10px; }
.task-actions .check-pill, .task-actions .soft-button { flex: 1 1 132px; width: auto; min-height: 52px; padding: 6px 10px; font-size: 13px; line-height: 1.5; }
.record-action-goal { display: block; font-size: 14px; line-height: 20px; }
.record-action-label { display: block; font-size: 13px; line-height: 18px; font-weight: 500; }
.task-actions .text-button { flex-basis: 100%; text-align: left; }
.task.large-font .task-actions { flex-direction: column; }
.task.large-font .task-actions .check-pill, .task.large-font .task-actions .soft-button { flex: none; width: 100%; min-height: 48px; font-size: 16px; padding: 12px; }
.task.large-font .record-action-goal, .task.large-font .record-action-label { font-size: 16px; line-height: 24px; }
@media (max-width: 340px) {
  .task-actions { flex-direction: column; }
  .task-actions .check-pill, .task-actions .soft-button { flex: none; width: 100%; min-height: 48px; font-size: 15px; padding: 8px 10px; }
  .task-top { flex-wrap: wrap; }
  .done-tag { max-width: 100%; }
}
.task-options { display: flex; align-items: center; gap: 12px; margin-top: 8px; flex-wrap: wrap; }
.task-options .text-button { padding: 6px 0; }
.task-options .undo { margin-left: auto; }
.done-tag { display: inline-flex; align-items: center; gap: 5px; color: var(--color-ink, #18382C); font-size: 13px; font-weight: 500; flex-shrink: 0; max-width: 140px; }
.stamp-in { animation: stamp-in .26s ease-out both; }
@keyframes stamp-in { 0% { transform: scale(1.35); opacity: 0; } 60% { transform: scale(.96); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }

/* 回归提示：只留一句引导，操作回到任务行本身。 */
.return-card { padding: 12px 14px; margin-bottom: 10px; }
.return-heading { color: var(--color-ink, #18382C); font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.return-body { margin-top: 6px; }

/* 折叠入口 */
.disclosure { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 48px; padding: 11px 14px; text-align: left; background: var(--color-surface, #fff); border: 1px solid var(--color-line, #DCE7DF); border-radius: 14px; margin-top: 8px; }
.chevron { width: 8px; height: 8px; border-right: 1.5px solid var(--color-primary, #246446); border-bottom: 1.5px solid var(--color-primary, #246446); transform: rotate(-45deg); flex-shrink: 0; margin: 0 4px; }
.chevron.down { transform: rotate(45deg); }
.chevron.up { transform: rotate(-135deg); }
.quote { margin: 18px 0 0; }

/* 表单 */
.form-field { margin-top: 16px; }
.field-label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--color-ink, #18382C); }
.input { width: 100%; min-height: 44px; height: 44px; padding: 9px 12px; border: 1px solid var(--color-control-border, #7A897D); border-radius: 10px; background: var(--color-surface, #fff); font-size: 15px; color: var(--color-ink, #18382C); }
/* Native input paints its own vertically centered text; vertical padding offsets its unfocused layer. */
input.input { padding-top: 0; padding-bottom: 0; }
/* 焦点：2px primary 内侧轮廓，不改变布局；错误态另有 2px error 边框与文字说明。 */
.input.focused, .picker.focused { box-shadow: inset 0 0 0 2px var(--color-primary, #246446); }
textarea.input { height: 96px; line-height: 1.6; }
.picker { min-height: 44px; padding: 9px 12px; border: 1px solid var(--color-control-border, #7A897D); border-radius: 10px; background: var(--color-surface, #fff); }
.picker-select { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.goal-row .input { width: 0; }
.field-hint { font-size: 13px; color: var(--color-secondary, #587065); margin-top: 6px; line-height: 1.5; }
.field-error { color: var(--color-error, #A23C2E); font-size: 13px; margin-top: 6px; overflow-wrap: anywhere; }
.summary-line { font-size: 13px; color: var(--color-secondary, #587065); margin: 16px 0 12px; }
.summary-line .strong { color: var(--color-ink, #18382C); font-weight: 600; }
.day-options { display: flex; flex-wrap: wrap; gap: 8px; }
.day-option { min-width: 44px; min-height: 44px; padding: 8px; border: 1px solid var(--color-control-border, #7A897D); border-radius: 10px; font-size: 13px; background: var(--color-surface, #fff); color: var(--color-ink, #18382C); }
.day-option.selected { background: var(--color-primary, #246446); color: var(--color-on-primary, #fff); border-color: var(--color-primary, #246446); }
.week-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.week-options .day-option { min-width: 0; width: 100%; min-height: 44px; padding: 8px 0; font-size: 15px; }
.direction-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.direction-options .day-option { min-width: 0; min-height: 44px; }
.frequency-actions { gap: 16px; }
.frequency-actions .text-button { padding-left: 0; }
.optional-fields { padding: 0 0 8px; }
.compact-form .form-field { margin-top: 14px; }
.segments { display: flex; gap: 4px; padding: 3px; background: var(--color-soft, #F7FAF7); border-radius: 10px; margin: 10px 0 4px; }
.segment { flex: 1; min-height: 44px; padding: 8px 6px; font-size: 14px; border-radius: 8px; color: var(--color-secondary, #587065); }
.segment.selected { background: var(--color-surface, #fff); color: var(--color-ink, #18382C); font-weight: 600; border: 1px solid var(--color-line, #DCE7DF); }

/* 统计 */
.metric-card { padding: 14px; }
.metric-note { font-size: 13px; color: var(--color-secondary, #587065); margin-top: 6px; }
.metric { font-size: 34px; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
.metric-suffix { font-size: 15px; }
.metric-caption { font-size: 15px; }
.calendar { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 5px; margin: 16px 0 12px; }
.cell { min-height: 48px; border-radius: 10px; padding: 5px 1px; background: var(--color-soft, #F7FAF7); font-size: 13px; border: 1px solid transparent; color: var(--color-ink, #18382C); }
.cell-weekday { display: block; font-size: 13px; }
.cell-status { display: block; font-size: 13px; line-height: 1.4; }
.cell.full { background: var(--color-primary, #246446); color: var(--color-on-primary, #fff); }
.cell.partial { background: var(--color-busy-bg, #EDF6EF); color: var(--color-busy-text, #246446); }
.cell.rest { background: transparent; color: var(--color-secondary, #587065); border-color: var(--color-line, #DCE7DF); }
.cell.picked { box-shadow: inset 0 0 0 2px var(--color-ink, #18382C); }
.legend { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: 13px; color: var(--color-secondary, #587065); }
.legend-item { display: flex; align-items: center; gap: 5px; }
.legend-mark { width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--color-control-border, #7A897D); }
.legend-mark.full { background: var(--color-primary, #246446); border-color: var(--color-primary, #246446); }
.legend-mark.partial { background: var(--color-busy-bg, #EDF6EF); border-color: var(--color-busy-bg, #EDF6EF); }
.legend-mark.pending { background: var(--color-soft, #F7FAF7); border-color: var(--color-soft, #F7FAF7); }
.legend-mark.rest { background: transparent; border: 1px dashed var(--color-control-border, #7A897D); }
.advice { display: flex; gap: 8px; align-items: flex-start; padding: 11px 12px; margin-top: 10px; }
.advice .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-primary, #246446); margin-top: 6px; flex-shrink: 0; }
.advice .advice-text { font-size: 13px; color: var(--color-ink, #18382C); line-height: 1.5; }
.advice .advice-label { font-size: 13px; color: var(--color-secondary, #587065); display: block; margin-top: 2px; }
.range { font-size: 13px; color: var(--color-secondary, #587065); margin: 10px 0 12px; }

/* 设置行 */
.setting-row { width: 100%; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 48px; padding: 10px 0; border-bottom: 1px solid var(--color-line, #DCE7DF); color: var(--color-ink, #18382C); }
.group .setting-row:last-child, .list-card .setting-row:last-child { border-bottom: 0; }
.setting-row > .sub { flex-shrink: 0; }
.menu-value { text-align: right; max-width: 55%; overflow-wrap: anywhere; }
.danger { color: var(--color-error, #A23C2E); }
.danger-zone { margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--color-line, #DCE7DF); }
.note-preview { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; color: var(--color-secondary, #587065); margin: 10px 0; }
.spaced { margin-top: 16px; }

/* 骨架 */
.skeleton { background: var(--color-soft, #F7FAF7); border-radius: 10px; animation: skeleton-pulse 1.6s ease-in-out infinite; }
.skeleton-title { width: 42%; height: 22px; margin-top: 12px; border-radius: 10px; }
.skeleton-sub { width: 58%; height: 14px; margin-top: 10px; }
.skeleton-card { height: 72px; margin-top: 10px; border-radius: 14px; }
.skeleton-note { margin-top: 16px; }
@keyframes skeleton-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

/* 分享预览（功能未启用，样式保留） */
.share-sheet { margin-top: 20px; padding: 20px 16px; border: 1px solid var(--color-line, #DCE7DF); border-radius: 14px; background: var(--color-soft, #F7FAF7); overflow-wrap: anywhere; }
.share-line { margin-top: 14px; line-height: 1.5; }

.page-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }

@import "styles/fusion.wxss";
