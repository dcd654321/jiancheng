/* 两张固定内容的预览卡：缩略图固定使用各自主题的颜色，不随页面预览变色。 */
.theme-options { display: flex; flex-direction: column; gap: 12px; margin: 20px 0 0; }
.theme-card { display: block; width: 100%; text-align: left; background: var(--color-surface, #FFFFFF); border: 1px solid var(--color-control-border, #819086); border-radius: 14px; padding: 14px; }
.theme-card.selected { border-width: 2px; padding: 13px; }
.theme-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.theme-name { font-size: 16px; font-weight: 600; }
.theme-badge { font-size: 13px; color: var(--color-secondary, #647067); }
.theme-card.selected .theme-badge { color: var(--color-primary, #486557); font-weight: 600; }
.theme-desc { margin-top: 4px; }
.theme-thumb { margin-top: 12px; border: 1px solid var(--color-line, #E2E7DF); border-radius: 10px; background: var(--color-page, #F7F8F5); padding: 10px; }
.thumb-title { font-size: 15px; font-weight: 600; color: var(--color-ink, #303A34); }
.thumb-goal { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
.thumb-main { font-size: 13px; font-weight: 600; color: var(--color-ink, #303A34); }
.thumb-btn { margin-top: 8px; min-height: 32px; line-height: 32px; padding: 0 12px; border-radius: 10px; color: var(--color-on-primary); background: var(--color-primary); font-size: 13px; text-align: center; }
.thumb-btn.soft { color: var(--color-primary); background: var(--color-busy-bg); }
.appearance-page { padding-bottom: calc(144px + env(safe-area-inset-bottom)); }
.appearance-page.with-recovery { padding-bottom: calc(248px + env(safe-area-inset-bottom)); }
.theme-submit-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 8px 16px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--color-line, #E2E7DF); background: var(--color-surface, #FFFFFF); }
.theme-submit-bar .theme-status, .theme-submit-bar .error { margin: 0 0 8px; }
.theme-submit-bar .primary { max-width: 560px; margin: 0 auto; }
