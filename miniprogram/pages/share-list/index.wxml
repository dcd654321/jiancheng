<view class="page">
  <view class="heading">我的分享</view><view class="sub">记录创建过的内容，不记录发给了谁。</view>
  <view wx:if="{{!enabled}}" class="notice spaced">分享功能尚未开放。</view>
  <view wx:elif="{{loading}}" class="sub spaced">正在读取…</view>
  <view wx:elif="{{dataUnavailable}}" class="error spaced">暂时无法读取，请先恢复数据同步。</view>
  <block wx:elif="{{dataReady}}">
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <button class="primary spaced" bindtap="onCreate">创建一份分享</button>
    <button class="text-button spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onRefreshList">刷新列表</button>
    <view wx:if="{{loaded && !items.length}}" class="empty"><view class="section-title">还没有创建分享</view><view class="sub">邀请朋友一起开始，或分享自己的轻计划和一周进展。</view></view>
    <button wx:for="{{items}}" wx:key="shareId" class="setting-row" data-id="{{item.shareId}}" bindtap="onOpen"><view class="grow"><view>{{item.title}}</view><view class="sub">{{item.createdLabel}} · {{item.statusLabel}}</view></view><view class="chevron" /></button>
    <button wx:if="{{nextCursor}}" class="secondary spaced" disabled="{{busy}}" bindtap="onMore">查看更多</button>
  </block>
</view>
