<view class="page">
  <view class="heading">给下一次，留个提醒</view>
  <view class="sub">仅提醒下一次，不会每天自动发送。计划时间仍只用于排序。</view>
  <view wx:if="{{!enabled}}" class="notice spaced">提醒尚未开放，习惯打卡不受影响。</view>
  <view wx:elif="{{loading}}" class="sub spaced">正在读取安排…</view>
  <view wx:elif="{{dataUnavailable}}" class="error spaced">请先恢复数据同步，再申请提醒。</view>
  <block wx:elif="{{dataReady}}">
    <picker range="{{slots}}" value="{{slotIndex}}" disabled="{{busy || retrySchedule}}" bindchange="onSlot"><view class="setting-row">提醒时段（北京时间）<text class="grow" />{{slots[slotIndex]}}<view class="chevron" /></view></picker>
    <button class="secondary spaced" disabled="{{busy || retrySchedule}}" bindtap="onPreview">{{preview ? '重新预览日期' : '看看下一次安排'}}</button>
    <view wx:if="{{preview}}" class="notice spaced"><view>{{preview.businessDate}} {{preview.slot}}</view><view class="sub">届时还有待做任务才会提醒；完成后不再发送。</view></view>
    <button wx:if="{{preview && !retrySchedule}}" class="primary spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onSubscribe">提醒我这一次</button>
    <button wx:if="{{retrySchedule}}" class="primary spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onRetrySchedule">重试登记这一次</button>
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <view class="row spaced"><view class="section-title grow">近期提醒</view><button class="link-button" disabled="{{busy}}" bindtap="onRefresh">刷新状态</button></view>
    <view wx:if="{{!items.length}}" class="sub">暂未申请提醒。</view>
    <view wx:for="{{items}}" wx:key="businessDate" class="setting-row"><view class="grow"><view>{{item.businessDate}} {{item.slot}}</view><view class="sub">{{item.label}}</view></view><button wx:if="{{item.canCancel}}" class="link-button" disabled="{{busy}}" data-date="{{item.businessDate}}" bindtap="onCancel">取消</button></view>
    <view class="sub spaced">发送状态不代表已送达或已阅读；网络或平台异常可能无法提醒，不作为重要事项的唯一提醒方式。</view>
  </block>
</view>
