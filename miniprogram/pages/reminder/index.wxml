<view class="page theme-{{theme}}">
  <view class="heading">给下一次，留个提醒</view>
  <view class="sub">仅提醒下一次，不会每天自动发送。计划时间仍只用于排序。</view>
  <view wx:if="{{!enabled}}" class="notice spaced">提醒尚未开放，习惯打卡不受影响。</view>
  <view wx:elif="{{loading}}" class="sub spaced">正在读取安排…</view>
  <view wx:elif="{{dataUnavailable}}" class="empty"><view class="heading">暂时没能读取记录</view><view class="sub">{{error || '请先恢复云端同步，再申请提醒。'}}</view><button class="primary spaced" bindtap="onDataRetry">{{recoveryLabel || '重新读取'}}</button></view>
  <block wx:elif="{{dataReady}}">
    <block wx:if="{{modern}}"><view class="segments spaced"><button class="segment {{type === 'self' ? 'selected' : ''}}" data-type="self" disabled="{{busy || retrySchedule}}" bindtap="onType">提醒我完成</button><button class="segment {{type === 'supervisor' ? 'selected' : ''}}" data-type="supervisor" disabled="{{busy || retrySchedule}}" bindtap="onType">提醒我监督</button></view><picker mode="date" value="{{businessDate}}" start="{{minDate}}" end="{{maxDate}}" disabled="{{busy || retrySchedule}}" bindchange="onDate"><view class="setting-row spaced">下一次日期<text class="grow" />{{businessDate}}<view class="chevron down" /></view></picker><picker mode="time" value="{{time}}" disabled="{{busy || retrySchedule}}" bindchange="onTime"><view class="setting-row">提醒时间（北京时间）<text class="grow" />{{time}}<view class="chevron down" /></view></picker><view class="section-title spaced">涵盖事项</view><view wx:if="{{!candidates.length}}" class="sub">{{type === 'supervisor' ? '当前没有可预约的监督约定。' : '这一天没有待完成的习惯。'}}</view><button wx:for="{{candidates}}" wx:key="id" class="setting-row reminder-candidate {{item.selected ? 'selected' : ''}}" disabled="{{busy || retrySchedule}}" data-id="{{item.id}}" bindtap="onCandidate"><text class="grow">{{item.title}}</text><text class="sub">{{item.deadline ? item.deadline + ' 前完成 · ' : ''}}{{item.selected ? '已选' : '选择'}}</text></button><view wx:if="{{type === 'supervisor'}}" class="sub spaced">提醒接收者是你；约定截止后仍未完成时，提醒你关注。完成或无需完成的事项不会发送。</view></block>
    <picker wx:else range="{{slots}}" value="{{slotIndex}}" disabled="{{busy || retrySchedule}}" bindchange="onSlot"><view class="setting-row">提醒时段（北京时间）<text class="grow" />{{slots[slotIndex]}}<view class="chevron" /></view></picker>
    <button class="secondary spaced" disabled="{{busy || retrySchedule}}" bindtap="onPreview">{{preview ? '重新预览日期' : '看看下一次安排'}}</button>
    <view wx:if="{{preview}}" class="notice spaced"><view>下一次：{{preview.sendDate || preview.businessDate}} {{preview.slot}}</view><view wx:if="{{preview.sendDate !== preview.businessDate}}" class="sub">检查 {{preview.businessDate}} 的约定</view><view wx:for="{{preview.items}}" wx:key="key" class="sub">{{item.title}}</view><view class="sub">届时还有待做任务才会提醒；完成后不再发送。</view></view>
    <button wx:if="{{preview && !retrySchedule}}" class="primary spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onSubscribe">提醒我这一次</button>
    <button wx:if="{{retrySchedule}}" class="primary spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onRetrySchedule">重试登记这一次</button>
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <view class="row spaced"><view class="section-title grow">近期提醒</view><button class="link-button" disabled="{{busy}}" bindtap="onRefresh">刷新状态</button></view>
    <view wx:if="{{!items.length}}" class="sub">暂未申请提醒。</view>
    <view wx:for="{{items}}" wx:key="key" class="setting-row"><view class="grow"><view>{{item.sendDate || item.businessDate}} {{item.slot}} {{item.type === 'supervisor' ? '· 监督提醒' : ''}}</view><view wx:if="{{item.sendDate !== item.businessDate}}" class="sub">检查 {{item.businessDate}} 的约定</view><view class="sub">{{item.label}}</view></view><button wx:if="{{item.canCancel}}" class="link-button" disabled="{{busy}}" data-date="{{item.businessDate}}" data-type="{{item.type || 'self'}}" bindtap="onCancel">取消</button></view>
    <view class="sub spaced">发送状态不代表已送达或已阅读；网络或平台异常可能无法提醒，不作为重要事项的唯一提醒方式。</view>
  </block>
</view>
