<view class="page mine-page theme-{{theme}}">
  <view wx:if="{{loading}}" class="empty"><view class="section-title">正在读取记录</view><view class="sub">请稍候。</view></view>
  <view wx:elif="{{dataUnavailable}}" class="empty"><view class="heading">暂时没能读取记录</view><view class="sub">{{error}}</view><button class="primary spaced" bindtap="onDataRetry">{{recoveryLabel || '重新读取'}}</button></view>
  <block wx:elif="{{dataReady}}">
    <view class="heading heading-xl">我的</view>
    <view class="mine-intro"><view class="mine-title">我的习惯空间</view><view class="sub">按自己的节奏，把日常慢慢做好。</view><view class="mine-count"><text>{{count}} 个习惯</text><text>{{todayDone}} 项今日完成</text></view></view>
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <view class="group"><view class="group-label">习惯管理</view><view class="menu-list"><button class="setting-row" bindtap="onManage"><view class="menu-icon"><image src="../../assets/menu/list-{{theme}}.png" /></view><text class="grow">管理我的习惯</text><text class="sub">{{count}}个</text><view class="chevron" /></button></view></view>
    <view class="group"><view class="group-label">偏好与提醒</view><view class="menu-list">
      <view class="setting-row quote-setting"><view class="grow">显示首页短句<view class="sub">在今日安排下方显示一句短句</view></view><label class="switch-hit" for="quote-switch"><switch id="quote-switch" checked="{{!hideQuote}}" disabled="{{dataReadOnly || writeBusy}}" color="{{primary}}" bindchange="onQuote" aria-label="显示首页短句" /></label></view>
      <button wx:if="{{appearanceEnabled}}" class="setting-row" bindtap="onAppearance"><view class="menu-icon"><image src="../../assets/menu/sliders-{{theme}}.png" /></view><view class="grow">外观主题<view wx:if="{{appearancePending}}" class="sub">保存结果待核对，打开后可继续核对</view></view><text class="sub">{{appearanceLabel}}</text><view class="chevron" /></button>
      <button wx:if="{{remindersEnabled}}" class="setting-row" bindtap="onReminders"><view class="menu-icon"><image src="../../assets/menu/clock-{{theme}}.png" /></view><view class="grow">下一次提醒</view><view class="chevron" /></button>
    </view></view>
    <view class="group social-group"><view class="menu-list"><button class="setting-row" bindtap="onToggleSocial" aria-expanded="{{socialOpen}}"><view class="menu-icon"><image src="../../assets/menu/people-{{theme}}.png" /></view><text class="grow">好友监督与分享</text><view class="chevron {{socialOpen ? 'down' : ''}}" /></button><view wx:if="{{socialOpen}}" class="social-options"><button wx:if="{{supervisionEnabled}}" class="setting-row" bindtap="onSupervisions"><view class="grow">好友监督<view class="sub">我监督的 · 监督我的</view></view><view class="chevron" /></button><button class="setting-row" open-type="share"><text class="grow">分享小程序</text><view class="chevron" /></button><button wx:if="{{sharingEnabled}}" class="setting-row" bindtap="onShares"><view class="grow">我的分享<view class="sub">创建、回看与撤回公开内容</view></view><view class="chevron" /></button></view><button class="setting-row" open-type="feedback"><view class="menu-icon"><image src="../../assets/menu/message-{{theme}}.png" /></view><text class="grow">意见与问题反馈</text><view class="chevron" /></button><navigator class="setting-row" url="/pages/discover/index"><view class="menu-icon"><image src="../../assets/menu/book-{{theme}}.png" /></view><view class="grow">习惯入门与模板</view><view class="chevron" /></navigator></view></view>
  </block>
  <view wx:if="{{!dataReady}}" class="group guide-group"><view class="menu-list"><navigator class="setting-row" url="/pages/discover/index"><view class="menu-icon"><image src="../../assets/menu/book-{{theme}}.png" /></view><view class="grow">习惯入门与模板</view><view class="chevron" /></navigator></view></view>
  <view class="account-caption sub">记录跟随当前微信账号</view>
</view>
