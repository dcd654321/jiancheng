<view class="page">
  <view class="heading">数据同步</view>
  <view wx:if="{{error}}" class="error spaced">{{error}}</view>
  <block wx:if="{{needsConsent}}">
    <view class="section-title">开始前请了解</view>
    <view class="sub">小程序会将习惯名称、目标、执行日期、打卡数量和你填写的备注保存到微信云开发环境，用于同步和换机找回。</view>
    <view class="sub spaced">不会获取手机号、头像、昵称、联系人或位置。你可以在“我的”中导出或清除全部数据。</view>
    <button class="primary spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onConsentAndStart">同意并开始使用</button>
  </block>
  <view wx:elif="{{loading}}" class="empty">
    <view class="section-title">正在读取记录</view><view class="sub">请稍候，不会创建重复数据。</view>
  </view>
  <view wx:elif="{{dataUnavailable}}" class="empty">
    <view class="section-title">暂时无法读取记录</view>
    <view class="sub">{{lastError || '请检查网络后重试，已有数据不会被清除。'}}</view>
    <button class="primary spaced" disabled="{{busy}}" loading="{{busy}}" bindtap="onRefresh">重新读取</button>
  </view>
  <block wx:elif="{{ready}}">
    <view class="section-title">{{syncText}}</view>
    <view class="sub">当前微信账号 · {{count}} 个习惯</view>
    <view class="sub">{{pending ? pending + ' 条记录等待同步，完成前请勿清缓存' : '这台设备保留了最近同步的记录'}}</view>
    <view wx:if="{{lastSyncedLabel}}" class="sub">最近同步：{{lastSyncedLabel}}</view>
    <view wx:if="{{lastError}}" class="error spaced">{{lastError}}</view>
    <view wx:if="{{conflict}}" class="notice">另一台设备已经修改了数据。当前设备的待同步操作仍被保留，不会自动覆盖。请先导出备份，再决定是否采用云端版本。</view>
    <view class="actions">
      <button wx:if="{{pending && !conflict}}" class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="onRetry">继续同步（{{pending}}）</button>
      <button class="secondary" disabled="{{busy}}" bindtap="onRefresh">读取最新记录</button>
      <button class="secondary" disabled="{{busy}}" bindtap="onBackup">导出备份</button>
      <button wx:if="{{conflict && conflict.snapshot}}" class="secondary danger" disabled="{{busy}}" bindtap="onUseRemote">舍弃待同步，采用云端</button>
    </view>
    <view class="sub spaced">备份可能包含私人备注，请妥善保管。</view>
  </block>
  <button wx:if="{{exportPath}}" class="text-button spaced" bindtap="onResend">重新发送备份文件</button>
</view>
