<import src="../../templates/share.wxml" />
<view class="page theme-{{theme}}">
  <view wx:if="{{loading}}" class="empty"><view class="section-title">正在读取分享…</view></view>
  <block wx:if="{{view}}">
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <view class="sub">{{statusLabel}}</view>
    <view wx:if="{{view.canCopy}}" class="sub">这是一份可参考的习惯计划。</view>
    <template is="share-content" data="{{view: view}}" />
    <view class="sub spaced">内容固定于创建时，有效期至 {{expires}}。打卡为用户自行记录。</view>
    <button wx:if="{{shareEnabled}}" class="primary spaced" open-type="share">分享给微信好友</button>
    <button wx:if="{{view.canCopy}}" class="secondary spaced" bindtap="onCopy">按这个计划试试</button>
    <view wx:if="{{view.canCopy}}" class="sub">进入小程序后，可以修改目标与日期，再确认创建；确认前不会写入你的账户。</view>
    <view wx:if="{{mine}}" class="actions spaced"><button wx:if="{{active}}" class="text-button" disabled="{{busy}}" data-action="revoke" bindtap="onManage">撤回公开分享</button><button class="text-button danger" disabled="{{busy}}" data-action="remove" bindtap="onManage">删除这份分享</button></view>
  </block>
  <view wx:elif="{{error}}" class="empty">
    <view class="heading">这份分享暂不可用</view>
    <view class="sub">{{error}}</view>
    <button class="primary spaced" bindtap="onStart">去今日</button>
    <button wx:if="{{mine}}" class="secondary" bindtap="onRetry">重新读取</button>
  </view>
  <view wx:elif="{{!loading}}" class="empty">
    <view class="heading">这份分享暂不可用</view>
    <view class="sub">链接可能已失效，或内容已被删除。</view>
    <button class="primary spaced" bindtap="onStart">去今日</button>
    <button class="secondary" bindtap="onRetry">重新读取</button>
  </view>
</view>
