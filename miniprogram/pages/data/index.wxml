<view class="page">
  <view wx:if="{{loading}}" class="empty"><view class="section-title">正在读取记录</view><view class="sub">请稍候。</view></view>
  <view wx:elif="{{dataUnavailable}}" class="empty"><view class="heading">暂时读不到云端记录</view><view class="sub">{{error}}</view></view>
  <block wx:elif="{{dataReady}}">
    <view class="heading">数据与隐私</view><view class="sub">记录跟随当前微信账号。</view>
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <view class="group"><view class="group-label">云端记录</view>
      <button class="setting-row" bindtap="onSync"><view class="grow">云端状态<view class="sub">{{syncText}}</view></view><view class="chevron" /></button>
    </view>
    <view class="group"><view class="group-label">隐私说明</view><button class="setting-row" bindtap="onPrivacy"><text class="grow">哪些数据会保存？</text><view class="chevron" /></button></view>
    <view class="danger-zone"><view class="field-label danger">清除个人数据</view><view class="sub">清除云端习惯、打卡、备注和已启用功能的偏好/分享。操作不可恢复。</view><button class="text-button danger spaced" disabled="{{deleting}}" loading="{{deleting}}" bindtap="onDelete">清除全部打卡数据</button></view>
  </block>
</view>
