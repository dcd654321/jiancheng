<import src="../../templates/photo-checkin.wxml" />
<import src="../../templates/task.wxml" />
<view class="page today-page {{dataReady && !total ? 'with-empty-state' : ''}} theme-{{theme}}">
  <view class="page-header">
    <view class="heading heading-xl">今日</view>
    <button wx:if="{{dataReady && total}}" class="add-button" bindtap="onToggleChooser" aria-expanded="{{chooserOpen}}">{{chooserOpen ? '收起' : '添加习惯'}}</button>
  </view>
  <view class="sub subline">{{dateLabel}}</view>
  <view wx:if="{{loading}}" class="loading-state" aria-busy="true">
    <view class="loading-status sub" role="status">{{startupLoadingText}}</view>
    <view class="startup-skeleton" aria-hidden="true">
      <view class="skeleton-card"><view class="skeleton-line skeleton-title" /><view class="skeleton-line skeleton-detail" /><view class="skeleton-line skeleton-footer" /></view>
      <view class="skeleton-card"><view class="skeleton-line skeleton-title" /><view class="skeleton-line skeleton-detail" /><view class="skeleton-line skeleton-footer" /></view>
    </view>
  </view>
  <view wx:elif="{{dataUnavailable}}" class="empty">
    <view class="heading">{{startupUnavailableTitle || '暂时没能读取记录'}}</view>
    <view class="sub">{{error || '数据没有丢失。检查网络后重试。'}}</view>
    <button class="primary spaced" disabled="{{loading}}" bindtap="onDataRetry">{{recoveryLabel || '重新读取'}}</button>
  </view>
  <block wx:elif="{{dataReady}}">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{readRefreshing && !writeBusy}}" class="sub read-status" role="status">正在更新今日习惯</view>
    <button wx:if="{{syncAttention}}" class="notice text-button" bindtap="onSync">{{syncText}} · 查看</button>
    <view wx:if="{{firstHabitGuide}}" class="notice first-guide"><text class="grow">{{firstHabitGuide}}</text><button class="text-button" bindtap="onDismissGuide">知道了</button></view>
    <block wx:if="{{total && chooserOpen}}">
      <view class="tpl-grid">
        <button wx:for="{{templates}}" wx:key="key" class="tpl-card" data-template="{{item.key}}" bindtap="onCreate"><text class="tpl-name">{{item.title}}</text><view class="tpl-line"><text class="tpl-goal">平时 {{item.target}}{{item.unit}}</text><text class="tpl-goal">忙时 {{item.minimum}}{{item.unit}}</text></view></button>
      </view>
      <button class="secondary" data-template="" bindtap="onCreate">自己设一个</button>
    </block>
    <block wx:if="{{total}}">
      <view class="today-summary">
        <view class="summary-top"><view class="summary-label"><text class="summary-number">{{done}}<text class="summary-total"> / {{total}}</text></text><text>已打卡</text></view><button class="text-button" bindtap="onProgress">查看进度<view class="chevron" /></button></view>
        <view class="summary-bottom"><view class="summary-progress"><view wx:for="{{progressSegments}}" wx:key="id" class="summary-segment {{item.status}}" /></view><text class="remaining">待做 {{pending.length}} 项</text></view>
      </view>
      <view wx:if="{{minimum}}" class="sub summary-busy">其中 {{minimum}} 项按忙时目标打卡</view>
      <button wx:if="{{supervisionEnabled && supervisionCount}}" class="text-button supervision-entry" bindtap="onSupervisions">我监督的 · {{supervisionOverdue ? supervisionOverdue + ' 项已过截止时间' : supervisionCount + ' 项约定'}}<view class="chevron" /></button>
      <view wx:if="{{writeBusy}}" class="sub write-status">{{writeStatus}}</view>
      <view class="timeline-head"><text>今天的安排</text><button wx:if="{{completed.length}}" id="completed-section" class="text-button" bindtap="onToggleCompleted" aria-expanded="{{showCompleted}}">{{showCompleted ? '收起' : '展开'}}已完成（{{completed.length}}）</button></view>
      <view wx:if="{{pinnedTasks.length}}" class="pinned-section"><view class="sub pinned-label">置顶习惯</view><block wx:for="{{pinnedTasks}}" wx:key="id"><template is="timeline-task" data="{{task: item, readOnly: dataReadOnly, writeBusy: writeBusy, taskIconColor: primary, recordingId: recordingId, recordingLabel: recordingLabel, recordingType: recordingType, quickMinimumEnabled: quickMinimumEnabled, largeFont: largeFont}}" /></block></view>
      <view class="timeline"><block wx:for="{{timelineTasks}}" wx:key="id"><template is="timeline-task" data="{{task: item, readOnly: dataReadOnly, writeBusy: writeBusy, taskIconColor: primary, recordingId: recordingId, recordingLabel: recordingLabel, recordingType: recordingType, quickMinimumEnabled: quickMinimumEnabled, largeFont: largeFont}}" /></block></view>
      <view wx:if="{{!pending.length}}" class="sub spaced">今天安排的都已打卡。</view>
      <button wx:if="{{completed.length && remindersEnabled}}" class="text-button" bindtap="onNextReminder">预约下一次提醒</button>
      <view wx:if="{{!hideQuote && total}}" class="sub quote">{{quote}}</view>
      <view class="timeline-note">时间仅用于安排顺序，不会发送提醒。</view>
    </block>
    <view wx:else class="today-empty">
      <button class="primary empty-create" disabled="{{dataReadOnly}}" data-template="" bindtap="onCreate">添加习惯</button>
    </view>
    <view wx:if="{{total && !pending.length && tomorrow}}" class="tomorrow spaced">
      <view class="section-title"><text>明天{{tomorrow.count ? '有 ' + tomorrow.count + ' 项安排' : '没有安排'}}</text></view>
      <view class="sub">{{tomorrow.label}} · 按计划时间排序，不发送提醒</view>
      <view wx:for="{{tomorrow.tasks}}" wx:key="id" class="tomorrow-task"><text class="grow">{{item.title}}</text><text class="sub">{{item.time || '时间自定'}} · {{item.target}}{{item.unit}}</text></view>
      <button class="text-button" bindtap="onManage">{{tomorrow.remaining ? '还有 ' + tomorrow.remaining + ' 项 · 查看安排' : '管理习惯安排'}}</button>
    </view>
  </block>
  <template is="photo-checkin" data="{{photoOpen, photoTitle, photoRequired, photoBusy, photoError, photoItems, photoCanSubmit, photoPending}}" />
</view>
