<import src="../../templates/task.wxml" />
<view class="page">
  <view wx:if="{{needsConsent}}" class="empty">
    <view class="heading">再忙，也能做一点。</view>
    <view class="sub">选一件小事，设好平时目标和忙时的小目标。做完就打卡，回头能看到自己做了几次。</view>
    <view class="sub">习惯和打卡保存到云端，同一微信账号可找回已同步记录。</view>
    <button class="primary spaced" bindtap="onDataStart">开始使用</button>
  </view>
  <view wx:elif="{{loading}}" class="empty"><view class="section-title">正在读取记录</view><view class="sub">请稍候，不会创建重复数据。</view></view>
  <view wx:elif="{{dataUnavailable}}" class="empty"><view class="section-title">暂时无法读取记录</view><view class="sub">{{error || '请检查网络后重试，已有数据不会被清除。'}}</view><button class="primary spaced" bindtap="onDataRetry">重新读取</button></view>
  <block wx:elif="{{dataReady}}">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="page-header"><view><view class="heading">今日</view><view class="sub">{{dateLabel}}</view></view><button class="add-button" bindtap="onCreate">添加习惯</button></view>
    <button wx:if="{{syncAttention}}" class="notice text-button" bindtap="onSync">{{syncText}} · 查看</button>
    <view wx:if="{{firstHabitGuide}}" class="notice first-guide"><text class="grow">{{firstHabitGuide}}</text><button class="text-button" bindtap="onDismissGuide">知道了</button></view>
    <view wx:if="{{returnGuide}}" class="notice return-guide">
      <view class="return-heading">今天继续「{{returnGuide.title}}」</view>
      <view>隔了几次也没关系，过去不用补打卡。做完今天的目标，再点“打卡”。</view>
      <view class="return-actions">
        <button class="secondary" data-id="{{returnGuide.id}}" data-date="{{date}}" bindtap="onReturnOriginal">{{returnGuide.simplified ? '恢复原目标' : '按原目标继续'}}</button>
        <button wx:if="{{returnGuide.originalTarget > 1}}" class="secondary" data-id="{{returnGuide.id}}" data-date="{{date}}" bindtap="onReturnSmall">少做一点{{returnGuide.minimum ? ' · ' + returnGuide.minimum + returnGuide.unit : ''}}</button>
      </view>
    </view>
    <view wx:if="{{!hideQuote}}" class="sub quote">{{quote}}</view>
    <block wx:if="{{total}}">
      <view class="row between section-title"><text>今日进度</text><text>{{done}} / {{total}}</text></view>
      <view class="meter"><view class="meter-fill" style="width: {{rate}}%"></view></view>
      <view wx:if="{{minimum}}" class="sub">其中 {{minimum}} 项为小目标完成</view>
      <view wx:if="{{pending.length}}" class="section-title">待完成 · {{pending.length}}</view>
      <block wx:for="{{pending}}" wx:key="id"><template is="task" data="{{task: item}}" /></block>
      <view wx:if="{{!pending.length}}" class="sub spaced">今天的安排已全部记录。</view>
      <button wx:if="{{completed.length}}" class="disclosure spaced" bindtap="onToggleCompleted" aria-expanded="{{showCompleted}}"><text class="grow">已完成 · {{completed.length}}</text><text class="sub">{{showCompleted ? '收起' : '查看'}}</text><view class="chevron {{showCompleted ? 'up' : 'down'}}" /></button>
      <block wx:if="{{showCompleted}}"><block wx:for="{{completed}}" wx:key="id"><template is="task" data="{{task: item}}" /></block></block>
    </block>
    <view wx:else class="empty"><view class="heading">{{hasHabits ? '今天没有安排' : '选一件今天就能做的事'}}</view><view class="sub">{{hasHabits ? '休息日不算漏做，看看接下来的安排。' : '先选一个现成目标，创建前可以改；忙时的小目标也已填好。'}}</view>
      <view wx:if="{{!hasHabits}}" class="template-row"><button class="template-choice" data-template="read" bindtap="onCreate">读5分钟</button><button class="template-choice" data-template="walk" bindtap="onCreate">走路10分钟</button><button class="template-choice" data-template="study" bindtap="onCreate">复习5分钟</button><button class="template-choice" data-template="tidy" bindtap="onCreate">整理3分钟</button></view>
      <button wx:if="{{hasHabits}}" class="secondary" bindtap="onManage">查看习惯安排</button>
    </view>
    <button class="disclosure spaced" bindtap="onAssistant"><view class="grow"><view>帮我定个小目标</view><view class="sub">填写可用时间，获取一个基础建议</view></view><view class="chevron" /></button>
  </block>
</view>
