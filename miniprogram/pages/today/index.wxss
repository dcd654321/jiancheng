.skeleton-wrap { padding-top: 6px; }
.today-summary { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 12px 0; }
.summary-count { display: flex; align-items: baseline; gap: 8px; color: var(--color-secondary, #647067); font-size: 14px; }
.today-summary .progress-value { font-size: 18px; color: var(--color-ink, #303A34); }
.summary-busy { margin: -4px 0 12px; }
.task-explain { margin: 0 0 12px; }
.return-line { margin: 0 0 8px; }
.today-page .empty { padding-top: 12px; }
.today-page .hero-title { margin-top: 8px; }
.template-hint { margin-top: 8px; }
.today-page.with-feedback { padding-bottom: calc(184px + env(safe-area-inset-bottom)); }
.write-status { margin: 8px 0; }
.completion-feedback { position: fixed; left: 16px; right: 16px; bottom: 12px; z-index: 9; padding: 12px 14px; border: 1px solid var(--color-control-border, #819086); border-radius: 16px; background: var(--color-surface, #FFFFFF); box-shadow: 0 3px 14px rgba(0, 0, 0, .06); }
.feedback-copy { min-width: 0; overflow-wrap: anywhere; }
.feedback-title { font-size: 16px; font-weight: 600; }
.feedback-undo { min-width: 64px; flex-shrink: 0; }
.feedback-all { width: 100%; text-align: left; margin-top: 2px; }
.tomorrow { margin-top: 22px; }
.tomorrow-task { display: flex; align-items: center; gap: 12px; padding: 10px 0; flex-wrap: wrap; }
.tomorrow-task .grow { min-width: 0; overflow-wrap: anywhere; }

/* 冷启动等待：问候 + 轻微生长的三根小柱 + 如实的读取说明；动画柔和、无跳变。 */
.loading-hero { text-align: center; padding: 26px 0 6px; }
.loading-greet { font-size: 26px; font-weight: 600; line-height: 1.3; }
.loading-note { margin-top: 8px; }
.loading-bars { display: flex; align-items: flex-end; justify-content: center; gap: 6px; height: 36px; margin: 22px 0 16px; }
.loading-bars .bar { width: 6px; border-radius: 6px; background: var(--color-primary, #486557); transform-origin: bottom; animation: bar-grow 1.8s ease-in-out infinite; }
.loading-bars .bar1 { height: 14px; }
.loading-bars .bar2 { height: 24px; animation-delay: .2s; }
.loading-bars .bar3 { height: 34px; animation-delay: .4s; }
@keyframes bar-grow { 0%, 100% { transform: scaleY(.5); opacity: .55; } 50% { transform: scaleY(1); opacity: 1; } }
.loading-progress { margin-top: 4px; }
