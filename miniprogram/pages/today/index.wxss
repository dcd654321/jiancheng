.loading-state { padding-top: 6px; }
.today-summary { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 12px 0; }
.summary-count { display: flex; align-items: baseline; gap: 8px; color: var(--color-secondary, #5F6C63); font-size: 14px; }
.today-summary .progress-value { font-size: 18px; color: var(--color-ink, #25352D); }
.summary-busy { margin: -4px 0 12px; }
.today-page .quote { margin: 0 0 8px; }
.today-page .empty { padding-top: 12px; }
.today-page.with-empty-state { display: flex; flex-direction: column; }
.today-empty { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 0; }
.empty-create { width: auto; min-width: 156px; padding: 12px 24px; }
.today-page .tpl-line { display: flex; flex-wrap: wrap; gap: 2px 8px; }
.tpl-goal { white-space: nowrap; }
.write-status { margin: 8px 0; }
.completed-group { border: 1px solid var(--color-line, #DBE2D9); border-radius: 16px; background: var(--color-surface, #FFFFFF); overflow: hidden; }
.completed-header { display: flex; align-items: center; gap: 12px; width: 100%; margin: 0; min-height: 48px; padding: 12px 14px; text-align: left; border: 0; border-radius: 0; background: var(--color-surface, #FFFFFF); }
.completed-header.button-hover { background: var(--color-soft, #EEF2EC); }
.completed-header.is-expanded { border-bottom: 1px solid var(--color-line, #DBE2D9); }
.completed-heading { font-size: 15px; font-weight: 500; }
.completed-list { padding: 2px 0; background: var(--color-surface, #FFFFFF); }
.completed-row { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--color-surface, #FFFFFF); }
.completed-row + .completed-row { border-top: 1px solid var(--color-line, #DBE2D9); }
.completed-open { flex: 1; min-width: 0; min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 4px 0; text-align: left; }
.completed-icon { flex-shrink: 0; display: flex; }
.completed-copy { flex: 1; min-width: 0; }
.completed-title { font-size: 16px; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.completed-goal { margin-top: 2px; font-size: 13px; color: var(--color-secondary, #5F6C63); line-height: 1.5; overflow-wrap: anywhere; }
.completed-undo { flex-shrink: 0; min-width: 44px; min-height: 44px; padding: 6px 4px; font-size: 13px; }
.completed-row.large-font { flex-wrap: wrap; }
.completed-row.large-font .completed-open { flex-basis: 100%; }
.completed-row.large-font .completed-undo { margin-left: 28px; }
.tomorrow { margin-top: 22px; }
.tomorrow-task { display: flex; align-items: center; gap: 12px; padding: 10px 0; flex-wrap: wrap; }
.tomorrow-task .grow { min-width: 0; overflow-wrap: anywhere; }
