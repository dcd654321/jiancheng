<import src="../../templates/task-summary.wxml" />
<view class="page theme-{{theme}}">
  <view wx:if="{{loading}}" class="empty"><view class="section-title">正在读取习惯</view><view class="sub">请稍候。</view></view>
  <view wx:elif="{{dataUnavailable}}" class="empty"><view class="heading">暂时没能读取记录</view><view class="sub">{{error}}</view><button class="primary spaced" bindtap="onDataRetry">{{recoveryLabel || '重新读取'}}</button></view>
  <view wx:elif="{{invalid}}" class="empty">
    <view class="heading">没有找到这个习惯</view>
    <view class="sub">{{error || '它可能已被删除，或链接不完整。'}}</view>
    <button class="secondary spaced" bindtap="onManage">返回我的习惯</button>
  </view>
  <block wx:elif="{{dataReady}}">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="heading">{{title}}</view><view class="sub habit-state">{{statusText}} · {{schedule}}</view>
    <block wx:if="{{featuresEnabled && current.status === 'active'}}"><button class="text-button" disabled="{{pinning || dataReadOnly || writeBusy}}" loading="{{pinning}}" bindtap="onPin">{{pinned ? '取消置顶' : '置顶这个习惯'}}</button><view class="sub">最多置顶一个；今天有安排时优先显示。</view><view wx:if="{{pinError}}" class="error">{{pinError}}</view></block>
    <view wx:if="{{writeBusy}}" class="sub spaced">{{writeStatus}}</view>
    <view wx:if="{{task}}"><view class="section-title">今天</view><template is="task-summary" data="{{task: task, largeFont: largeFont, taskIconColor: primary}}" /></view>
    <view wx:else class="notice">今天没有安排，不计入未打卡。</view>
    <view class="card detail-actions">
      <view wx:if="{{task || noteDirty}}" class="note-section">
        <button class="action-header note-header" bindtap="onToggleNote" aria-expanded="{{noteOpen || noteDirty}}"><text class="grow">{{noteDirty ? '备注草稿 · 尚未保存' : note ? '今天的备注' : '留一句话（选填）'}}</text><text class="sub">{{noteDirty ? '编辑中' : noteOpen ? '收起' : '编辑'}}</text><view class="chevron {{noteOpen || noteDirty ? 'up' : 'down'}}" /></button>
        <view wx:if="{{!noteOpen && !noteDirty && note}}" class="note-preview">{{note}}</view>
        <view wx:if="{{noteOpen || noteDirty}}" class="form-field note-form">
          <label class="field-label" for="note">今天的备注</label>
          <view wx:if="{{noteDirty}}" class="sub">{{noteExpired ? noteDate + ' 的草稿未提交，不能保存到今天。请先复制保留。' : '尚未保存 · 暂存于本次打开，退出小程序前请保存。'}}</view>
          <textarea id="note" class="input {{focusNote ? 'focused' : ''}}" maxlength="140" value="{{note}}" bindinput="onNote" bindfocus="onNoteFocus" bindblur="onNoteBlur" placeholder="只留给自己，不会包含在分享中" />
          <view class="row note-actions"><button class="text-button" disabled="{{noteExpired || dataReadOnly || writeBusy}}" bindtap="onSaveNote">保存备注</button><button wx:if="{{noteDirty}}" class="text-button" bindtap="onCopyNote">复制备注</button><button wx:if="{{noteDirty}}" class="text-button" bindtap="onDiscardNote">放弃草稿</button></view>
        </view>
      </view>
      <button class="action-header plan-action" bindtap="onEdit"><text class="grow">调整计划</text><view class="chevron" /></button>
      <view class="more-group">
        <button class="action-header more-header {{moreOpen ? 'is-expanded' : ''}}" bindtap="onMore" aria-expanded="{{moreOpen}}"><text class="grow">更多操作</text><text class="sub">{{plannedStatus === 'archived' ? '取消归档、删除' : plannedStatus === 'paused' ? '恢复、归档、删除' : '暂停、归档、删除'}}</text><view class="chevron {{moreOpen ? 'up' : 'down'}}" /></button>
        <view wx:if="{{moreOpen}}" class="more-content">
          <view class="sub more-help">状态调整从明天生效，今天和历史记录保留。</view>
          <view class="more-actions">
            <button wx:if="{{plannedStatus === 'active'}}" class="setting-row" disabled="{{dataReadOnly || writeBusy}}" data-status="paused" bindtap="onStatus">暂停</button>
            <button wx:elif="{{plannedStatus === 'paused'}}" class="setting-row" disabled="{{dataReadOnly || writeBusy}}" bindtap="onResume">恢复</button>
            <button wx:if="{{plannedStatus === 'archived'}}" class="setting-row" disabled="{{dataReadOnly || writeBusy}}" bindtap="onUnarchive">取消归档</button>
            <button wx:else class="setting-row danger" disabled="{{dataReadOnly || writeBusy}}" data-status="archived" bindtap="onStatus">归档</button>
            <button class="setting-row danger" disabled="{{dataReadOnly || writeBusy || pinning || deleteConfirming}}" loading="{{writeBusy && recordingType === 'deleteHabit'}}" bindtap="onDeleteHabit">{{writeBusy && recordingType === 'deleteHabit' ? '正在删除…' : '删除习惯'}}</button>
          </view>
          <view class="sub delete-help">删除立即生效，习惯及全部历史打卡、备注将一并删除，无法恢复。</view>
        </view>
      </view>
    </view>
    <button wx:if="{{featuresEnabled && current.status === 'active' && current.minimum}}" class="text-button" bindtap="onSharePlan">分享这份轻计划</button>
    <view class="section-title">近28天有安排的记录</view>
    <view wx:if="{{!history.length}}" class="sub">这段时间还没有安排，不算漏做。</view>
    <view wx:else class="card list-card"><view wx:for="{{visibleHistory}}" wx:key="date" class="setting-row"><view class="grow">{{item.date}}<view class="sub">{{item.goal}}</view></view><text class="sub">{{item.status}}</text></view></view>
    <button wx:if="{{history.length > 7}}" class="text-button spaced" bindtap="onToggleHistory">{{showHistory ? '收起历史' : '查看全部 ' + history.length + ' 天'}}</button>
  </block>
</view>
