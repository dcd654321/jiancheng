/* pages/detail/index.wxss */
.note-actions { flex-wrap: wrap; gap: 4px 12px; }
.detail-actions { margin-top: 12px; overflow: hidden; }
.action-header { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 48px; padding: 11px 14px; margin: 0; text-align: left; border: 0; border-radius: 0; background: var(--color-surface, #FFFFFF); }
.action-header.button-hover { background: var(--color-soft, #EEF2EC); }
.note-section, .plan-action { border-bottom: 1px solid var(--color-line, #DBE2D9); }
.note-section .note-preview { margin: 0; padding: 0 14px 12px; }
.note-form { margin-top: 0; padding: 0 14px 10px; }
.more-group { background: var(--color-surface, #FFFFFF); }
.more-header.is-expanded { border-bottom: 1px solid var(--color-line, #DBE2D9); }
.more-content, .more-actions { background: var(--color-surface, #FFFFFF); }
.more-help { margin: 0; padding: 10px 14px 0; }
.more-actions { padding: 0 14px; }
.more-actions .setting-row:last-child { border-bottom: 0; }
.delete-help { margin: 0; padding: 0 14px 12px; }
