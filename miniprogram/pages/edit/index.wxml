<view class="page compact-form edit-page {{keyboardOpen ? 'keyboard-open' : ''}} theme-{{theme}}">
  <view wx:if="{{loading}}" class="empty"><view class="section-title">正在读取记录</view><view class="sub">请稍候。</view></view>
  <view wx:elif="{{dataUnavailable}}" class="empty"><view class="heading">暂时没能读取记录</view><view class="sub">{{error}}</view><button class="primary spaced" bindtap="onDataRetry">{{recoveryLabel || '重新读取'}}</button></view>
  <block wx:elif="{{dataReady}}">
    <view class="back-heading"><button class="back-button" bindtap="onBack" aria-label="返回"><view class="chevron back-chevron" /></button><view class="heading">{{editing ? '编辑习惯' : compact ? '确认新习惯' : '添加习惯'}}</view></view>
    <view class="sub form-intro">{{editing ? '修改明天生效，今天的安排和历史不会改变。' : compact ? '目标可以按你的时间修改；确认后再创建。' : '平时认真做，忙时也能留下一小步。'}}</view>
    <view wx:if="{{error}}" class="error spaced">{{error}}</view>
    <view wx:if="{{source}}" class="inline-note sub">{{source}}</view>
    <view wx:if="{{draftDirty}}" class="notice draft-notice"><view>{{draftRestored ? '已接续未保存的输入' : '尚未保存'}}</view><view class="sub">返回后可在本次打开中继续；退出小程序后会丢失，请保存或复制。</view><view class="row"><button class="text-button" bindtap="onCopyDraft">复制输入</button><button class="text-button" disabled="{{saving}}" bindtap="onDiscardDraft">放弃修改</button></view></view>
    <view id="field-title" class="form-field">
      <view class="row between"><label class="field-label" for="title">习惯名称</label><text class="sub">{{titleCount}}/20</text></view>
      <input id="title" class="input {{focusField === 'title' ? 'focused' : ''}} {{fieldErrors.title ? 'invalid' : ''}}" value="{{title}}" maxlength="-1" disabled="{{saving}}" aria-label="习惯名称{{fieldErrors.title ? '，' + fieldErrors.title : ''}}" placeholder="例如：下班读一会儿" data-field="title" bindinput="onInput" bindblur="onBlur" bindfocus="onFocus" bindkeyboardheightchange="onKeyboard" />
      <view wx:if="{{fieldErrors.title}}" class="field-error">{{fieldErrors.title}}</view>
    </view>
    <view id="field-target" class="form-field">
      <label class="field-label" for="target">平时目标</label>
      <view class="row goal-row">
        <input id="target" class="input grow {{focusField === 'target' ? 'focused' : ''}} {{fieldErrors.target ? 'invalid' : ''}}" type="number" maxlength="4" disabled="{{saving}}" value="{{target}}" placeholder="{{targetPlaceholder}}" data-field="target" bindinput="onInput" bindblur="onBlur" bindfocus="onFocus" bindkeyboardheightchange="onKeyboard" aria-label="平时目标数量{{fieldErrors.target ? '，' + fieldErrors.target : ''}}" />
        <picker mode="selector" range="{{units}}" disabled="{{saving}}" bindchange="onUnit" aria-label="选择目标单位"><view class="picker picker-select">{{unit}}<view class="chevron down" /></view></picker>
      </view>
      <view wx:if="{{fieldErrors.target}}" class="field-error">{{fieldErrors.target}}</view>
    </view>
    <view id="field-minimum" class="form-field">
      <view class="row between minimum-heading"><label class="field-label" for="minimum">忙时目标 <text class="optional-label">可选</text></label><label class="switch-hit" for="minimum-switch"><switch id="minimum-switch" checked="{{minimumVisible}}" disabled="{{saving}}" color="{{primary}}" bindchange="onToggleMinimum" aria-label="设置可选忙时目标" /></label></view>
      <block wx:if="{{minimumVisible}}"><view class="row goal-row">
      <input id="minimum" class="input grow {{focusField === 'minimum' ? 'focused' : ''}} {{fieldErrors.minimum ? 'invalid' : ''}}" type="number" maxlength="4" disabled="{{saving}}" value="{{minimum}}" aria-label="忙时目标（选填）{{fieldErrors.minimum ? '，' + fieldErrors.minimum : ''}}" placeholder="例如：2；可留空" data-field="minimum" bindinput="onInput" bindblur="onBlur" bindfocus="onFocus" bindkeyboardheightchange="onKeyboard" />
      <view class="unit-display">{{unit}}</view></view>
      <view class="field-hint">忙碌时做这个目标，也算完成一次打卡。</view>
      <view wx:if="{{fieldErrors.minimum}}" class="field-error">{{fieldErrors.minimum}}</view></block><view wx:else class="field-hint">可随时为忙碌的日子加一个更小的目标。</view>
    </view>
    <view class="form-field">
      <block wx:if="{{compact}}">
        <button class="setting-row" disabled="{{saving}}" bindtap="onToggleFrequency" aria-expanded="{{frequencyOpen}}"><text class="grow">执行频率</text><text class="sub">{{frequencyLabel}}</text><text class="text-button">{{frequencyOpen ? '收起' : '调整'}}</text></button>
      </block>
      <view wx:else class="row between"><view class="field-label">重复星期</view><text class="sub">{{frequencyLabel}}</text></view>
      <view wx:if="{{!compact || frequencyOpen}}" id="field-weekdays" class="form-field">
        <view class="week-options {{fieldErrors.weekdays ? 'invalid' : ''}}"><button wx:for="{{days}}" wx:key="value" class="day-option {{item.selected ? 'selected' : ''}}" disabled="{{saving}}" data-day="{{item.value}}" bindtap="onDay" aria-label="周{{item.label}}{{item.selected ? '已选' : '未选'}}">{{item.label}}</button></view>
        <view class="field-hint">{{frequencyLabel}} · 不含节假日调休。</view>
        <view wx:if="{{fieldErrors.weekdays}}" class="field-error">{{fieldErrors.weekdays}}</view>
      </view>
    </view>
    <view wx:if="{{!editing}}" class="form-field"><view wx:if="{{!compact}}" class="field-label">开始日期</view>
      <button wx:if="{{compact}}" class="setting-row" disabled="{{saving}}" bindtap="onToggleStart" aria-expanded="{{startOpen}}"><text class="grow">开始日期</text><text class="sub">{{startOffset === 1 ? '明天开始' : '今天开始'}}</text><text class="text-button">{{startOpen ? '收起' : '修改'}}</text></button>
      <picker wx:if="{{!compact || startOpen}}" mode="selector" range="{{startOptions}}" range-key="label" value="{{startIndex}}" disabled="{{saving || capacityFull}}" bindchange="onStartPicker" aria-label="开始日期"><view class="picker picker-select">{{startOptions[startIndex].label}}<view class="chevron down" /></view></picker>
    </view>
    <view wx:if="{{showStartSummary}}" class="summary-line">{{editing ? '修改从明天生效：' : '首次安排：'}}<text class="strong">{{editing ? effectiveLabel : firstLabel}}</text></view>
    <view wx:if="{{capacityNote}}" class="notice">{{capacityNote}}<button wx:if="{{capacityFull}}" class="text-button" bindtap="onManage">管理习惯</button></view>
    <button class="disclosure spaced" disabled="{{saving}}" bindtap="onMore" aria-expanded="{{moreOpen}}"><view class="grow"><view>更多设置</view><view class="sub">{{moreSummary}}</view></view><view class="chevron {{moreOpen ? 'up' : 'down'}}" /></button>
    <view wx:if="{{moreOpen}}" class="optional-fields"><view wx:if="{{targetHint}}" class="field-hint">{{targetHint}}</view><view class="field-label">快捷选择星期</view><view class="row frequency-actions"><button class="text-button" disabled="{{saving}}" data-kind="daily" bindtap="onFrequency">每天</button><button class="text-button" disabled="{{saving}}" data-kind="work" bindtap="onFrequency">周一至周五</button></view>
      <view id="field-time" class="form-field"><view class="field-label">计划时间（选填）</view><view class="row"><picker class="grow" mode="time" disabled="{{saving}}" value="{{time || '21:30'}}" bindchange="onTime"><view class="picker picker-select {{fieldErrors.time ? 'invalid' : ''}}">{{time || '不固定时间'}}<view class="chevron down" /></view></picker><button wx:if="{{time}}" class="text-button" disabled="{{saving}}" bindtap="clearTime">清除</button></view><view class="field-hint">只用于排序，不会发送提醒。</view><view wx:if="{{fieldErrors.time}}" class="field-error">{{fieldErrors.time}}</view></view>
    </view>
    <view class="submit-bar {{keyboardOpen ? 'inline' : ''}}">
      <view wx:if="{{editing}}" class="sub submit-note">修改从明天生效</view>
      <button class="primary" loading="{{saving}}" disabled="{{saving || dataReadOnly || (!editing && capacityFull && !confirmedCreate)}}" bindtap="onSave">{{saving ? (editing ? '正在保存…' : '正在创建…') : (editing ? '保存计划' : confirmedCreate ? '核对并返回今日' : '添加习惯')}}</button>
    </view>
  </block>
</view>
