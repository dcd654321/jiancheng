/* 提交底栏：键盘关闭时固定在底部（48px 按钮 + 安全区），
   键盘打开时回到内容流，保证当前输入与错误可以滚动到键盘上方。 */
.edit-page { padding-bottom: calc(112px + env(safe-area-inset-bottom)); }
.edit-page.keyboard-open { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.submit-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  background: var(--color-surface, #FFFFFF);
  border-top: 1px solid var(--color-line, #E2E7DF);
  padding: 10px 18px calc(16px + env(safe-area-inset-bottom));
}
.submit-bar.inline { position: static; border-top: 0; padding: 16px 0 0; background: transparent; }
.submit-bar .primary { display: block; max-width: 560px; margin: 0 auto; }
.submit-note { text-align: center; margin-bottom: 6px; }
